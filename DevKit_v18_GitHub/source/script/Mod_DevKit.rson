        {
          "Type": "Top",
          "Name": "Answer 72",
          "Pos.x": 0,
          "Pos.y": 2700,
          "Parent": 215,
          "#": 216,
          "Total.Lines": 28,
          "Code.Type": "Turn",
          "Code": [
            "    for(i=0;i<GalaxyStars();i=i+1)\r",
            "        {\r",
            "        temp_dword=GalaxyStar(i);\r",
            "        if(StarOwner(temp_dword)!=2)continue;\r",
            "        if(StarRuins(temp_dword,'CB')>0)\r",
            "            {\r",
            "            temp_dword2=StarRuins(temp_dword,'CB');\r",
            "            ShipDestroy(temp_dword2,1);\r",
            "            }\r",
            "        for(j=0;j<StarPlanets(temp_dword);j=j+1)\r",
            "            {\r",
            "            temp_dword2=StarPlanets(temp_dword,j);\r",
            "            if(PlanetOwner(temp_dword2)==6)continue;\r",
            "            PlanetOwner(temp_dword2,PlanetRace(temp_dword2));\r",
            "            BuyWarrior(temp_dword2);\r",
            "            }\r",
            "        for(j=0;j<StarShips(temp_dword);j=j+1)\r",
            "            {\r",
            "            temp_dword2=StarShips(temp_dword,j);\r",
            "            if(ShipTypeN(temp_dword2)!=t_Pirate)continue;\r",
            "            OrderNone(temp_dword2);\r",
            "            OrderLock(temp_dword2,1);\r",
            "            ShipDestroy(temp_dword2,1);\r",
            "            }\r",
            "        }\r",
            "    PirateWin(3);\r",
            "    DChange(13);\r",
            "    exit;\r"
          ]
        },
