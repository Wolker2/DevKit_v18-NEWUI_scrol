        },
        {
          "Type": "Top",
          "Name": "init_code",
          "Pos.x": 720,
          "Pos.y": 2800,
          "Parent": -1,
          "#": 228,
          "Total.Lines": 3064,
          "Code.Type": "Init",
          "Code": [
            "if(CapitalShipStats(ShipItems(Player(), 0)) < 1) {\r",
            "//Если на корабле игрока нет мостика, добавляется мостик под номером 2 из Main в моде DevKit\r",
            "CapitalShipStats(ShipItems(Player(), 0), 2);\r",
            "}\r",
            "function g_DevKitButton() { OpenCustomForm('DevKitUI'); }\r",
            "function DevKitDialogHook()\r",
            "{\r",
            "if(DevKitVisibility == 2 && PlayerBridge())\r",
            "{\r",
            "DevKitVisibility = 1;\r",
            "AddDialogOverride('DevKit', 1000000);\r",
            "}\r",
            "else if((PlayerBridge() || GetShipRuins(Player()) || GetShipPlanet(Player()) || GetTalkShip()) && DevKitVisibility > 0)\r",
            "{\r",
            "if(GetTalkShip()) AddDialogInject('KillThisShit', '', 'Убейся.', 50);\r",
            "AddDialogInject('DevKit', '', CT(\"Script.Mod_DevKit.3\"), 1000);\r",
            "}\r",
            "}\r",
            "function RaceSetDefine(race_str, split_type)\r",
            "{\r",
            "//Определяем сет рас\r",
            "int race_set = 0;\r",
            "\r",
            "if(race_str == '' || race_str == 'Any')\r",
            "{\r",
            "if(split_type != 'Acryn') race_set = 1951; //По умолчанию все расы, кроме неизвестной (1 + 2 + 4 + 8 + 16 + 128 + 256 + 512 + 1024)\r",
            "else race_set = 159; //По умолчанию все расы, кроме неизвестной и доминаторов (1 + 2 + 4 + 8 + 16 + 128)\r",
            "}\r",
            "else\r",
            "{\r",
            "int dom_race_restrict = 0;\r",
            "//Для акринов по умолчанию не добавляем в сет доминаторские расы\r",
            "if(split_type == 'Acryn') dom_race_restrict = 1;\r",
            "int cycle_count = 0;\r",
            "\r",
            "str par_str = 'begin';\r",
            "while(par_str != '')\r",
            "{\r",
            "par_str = GetParFromString(race_str, ',', cycle_count, 1);\r",
            "\r",
            "if(par_str == 'Maloc')\r",
            "{\r",
            "if(!(race_set & 1)) race_set = race_set + 1;\r",
            "}\r",
            "else if(par_str == 'Peleng')\r",
            "{\r",
            "if(!(race_set & 2)) race_set = race_set + 2;\r",
            "}\r",
            "else if(par_str == 'People')\r",
            "{\r",
            "if(!(race_set & 4)) race_set = race_set + 4;\r",
            "}\r",
            "else if(par_str == 'Fei')\r",
            "{\r",
            "if(!(race_set & 8)) race_set = race_set + 8;\r",
            "}\r",
            "else if(par_str == 'Gaal')\r",
            "{\r",
            "if(!(race_set & 16)) race_set = race_set + 16;\r",
            "}\r",
            "else if(par_str == 'None')\r",
            "{\r",
            "if(!(race_set & 64)) race_set = race_set + 64;\r",
            "}\r",
            "else if(par_str == 'PirateClan')\r",
            "{\r",
            "if(!(race_set & 128)) race_set = race_set + 128;\r",
            "}\r",
            "// Не используется в оригинальной игре! /////////////\r",
            "else if(par_str == 'Kling')\r",
            "{\r",
            "if(!(race_set & 256)) race_set = race_set + 256;\r",
            "if(!(race_set & 512)) race_set = race_set + 512;\r",
            "if(!(race_set & 1024)) race_set = race_set + 1024;\r",
            "dom_race_restrict = 1;\r",
            "}\r",
            "////////////////////////////////////////////////////\r",
            "else if(par_str == 'Blazer')\r",
            "{\r",
            "if(!(race_set & 256))race_set = race_set + 256;\r",
            "dom_race_restrict = 1;\r",
            "}\r",
            "else if(par_str == 'Keller')\r",
            "{\r",
            "if(!(race_set & 512))race_set = race_set + 512;\r",
            "dom_race_restrict = 1;\r",
            "}\r",
            "else if(par_str == 'Terron')\r",
            "{\r",
            "if(!(race_set & 1024))race_set = race_set + 1024;\r",
            "dom_race_restrict = 1;\r",
            "}\r",
            "else if(par_str == 'NonKling')\r",
            "{\r",
            "dom_race_restrict = 2;\r",
            "}\r",
            "\r",
            "cycle_count = cycle_count + 1;\r",
            "}\r",
            "\r",
            "if(!dom_race_restrict)race_set = race_set + 1792; //По умолчанию добавляем в сет все доминаторские серии\r",
            "//Удаляем все доминаторские серии, если был установлен параметр NonKling\r",
            "else if(dom_race_restrict == 2)\r",
            "{\r",
            "if((race_set & 256))race_set = race_set - 256;\r",
            "if((race_set & 512))race_set = race_set - 512;\r",
            "if((race_set & 1024))race_set = race_set - 1024;\r",
            "}\r",
            "}\r",
            "\r",
            "result = race_set;\r",
            "}\r",
            "\r",
            "//SetBaseType('' + t_Engine, '', 8, 1);\r",
            "function SetBaseType(str type, str custom_type, GTL, param)\r",
            "{\r",
            "str dam_type = 'NotWeapon';\r",
            "str param_type;\r",
            "\r",
            "int shots_count = 0;\r",
            "int attacks_count = 0;\r",
            "int shot_type_check = 0;\r",
            "\r",
            "if(type==t_Hull)\r",
            "{\r",
            "type='Hull';\r",
            "\r",
            "//Броня\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.Hull.mAlloy');\r",
            "param=4 + GetParFromString(tstr, ',', GTL-1, 1);\r",
            "\r",
            "param_type = 'Hull armor';\r",
            "}\r",
            "else if(param == 2)\r",
            "{\r",
            "param=0;\r",
            "param_type = 'Hull mass';\r",
            "}\r",
            "}\r",
            "else if(type>=t_Weapon1 && type<=t_CustomWeapon)\r",
            "{\r",
            "if(type <= t_Weapon9)custom_type='W0'+(0+type-(t_Weapon1-1));\r",
            "else if(type != t_CustomWeapon)custom_type='W'+(0+type-(t_Weapon1-1));\r",
            "\r",
            "if(type != t_CustomWeapon)tint = GetCustomWeaponData(0+type, 'DamageType');\r",
            "else tint = GetCustomWeaponData(custom_type, 'DamageType');\r",
            "\r",
            "if((tint & 1))dam_type='WEnergy';\r",
            "else if((tint & 2))dam_type='WSplinter';\r",
            "else if((tint & 3))dam_type='WMissile';\r",
            "\r",
            "//Максимальный урон (на минимальный бонусы не применяются)\r",
            "if(param == 1)\r",
            "{\r",
            "if(type != t_CustomWeapon)\r",
            "{\r",
            "tint = CT('Items.Weapon.Stats.'+(0+type-(t_Weapon1-1))+'.MaxDamage');\r",
            "param = round((0.0 + GetParFromString(CT('Items.Weapon.Stats.'+(0+type-(t_Weapon1-1))+'.mWeaponDamage'), ',', GTL-1, 1)) * tint);\r",
            "}\r",
            "else\r",
            "{\r",
            "tint = CT('Items.Weapon.Stats.'+custom_type+'.MaxDamage');\r",
            "param = round((0.0 + GetParFromString(CT('Items.Weapon.Stats.'+custom_type+'.mWeaponDamage'), ',', GTL-1, 1)) * tint);\r",
            "}\r",
            "param = round(0.12 * param + 0.40 * tint + 3 + param);\r",
            "\r",
            "param_type = 'Max damage';\r",
            "}\r",
            "//Дальность\r",
            "else if(param == 2)\r",
            "{\r",
            "if(type != t_CustomWeapon)param = GetCustomWeaponData(0+type, 'AverageRadius');\r",
            "else param = GetCustomWeaponData(custom_type, 'AverageRadius');\r",
            "tint = param;\r",
            "\r",
            "if(GTL == 1)param = round(0.90 * param);\r",
            "else if(GTL == 2)param = round(0.95 * param);\r",
            "else if(GTL == 3)param = round(0.95 * param);\r",
            "else if(GTL == 4)param = round(1.00 * param);\r",
            "else if(GTL == 5)param = round(1.00 * param);\r",
            "else if(GTL == 6)param = round(1.05 * param);\r",
            "else if(GTL == 7)param = round(1.05 * param);\r",
            "else if(GTL == 8)param = round(1.10 * param);\r",
            "\r",
            "param = round(0.07 * param + 0.11 * tint + param);\r",
            "\r",
            "param_type = 'Weapon range';\r",
            "}\r",
            "//Максимальный урон, наносимый за один ход или DPD\r",
            "else if(param == 3)\r",
            "{\r",
            "//Вычисляем максимальный урон\r",
            "if(type != t_CustomWeapon)\r",
            "{\r",
            "tint = CT('Items.Weapon.Stats.' + (0 + type - (t_Weapon1 - 1)) + '.MaxDamage');\r",
            "param = round((0.0 + GetParFromString(CT('Items.Weapon.Stats.' + (0 + type - (t_Weapon1 - 1)) + '.mWeaponDamage'), ',', GTL - 1, 1)) * tint);\r",
            "}\r",
            "else\r",
            "{\r",
            "tint = CT('Items.Weapon.Stats.' + custom_type + '.MaxDamage');\r",
            "param = round((0.0 + GetParFromString(CT('Items.Weapon.Stats.' + custom_type + '.mWeaponDamage'), ',', GTL - 1, 1)) * tint);\r",
            "}\r",
            "param = round(0.12 * param + 0.40 * tint + 3 + param);\r",
            "\r",
            "//Учитываем число залпов в выстреле\r",
            "if(type != t_CustomWeapon)shots_count = GetCustomWeaponData(0 + type, 'ShotCount');\r",
            "else shots_count = GetCustomWeaponData(custom_type, 'ShotCount');\r",
            "\r",
            "//Учитываем число выстрелов в ходу\r",
            "if(type != t_CustomWeapon)attacks_count = GetCustomWeaponData(0 + type, 'AttackCount');\r",
            "else attacks_count = GetCustomWeaponData(custom_type, 'AttackCount');\r",
            "\r",
            "//Проверяем тип выстрела\r",
            "if(type != t_CustomWeapon)tstr = TrimNumbers(GetCustomWeaponData(0 + type, 'ShotType'));\r",
            "else tstr = TrimNumbers(GetCustomWeaponData(custom_type, 'ShotType'));\r",
            "\r",
            "if(tstr == 'Rocket' || tstr == 'Missile')shot_type_check = 1;\r",
            "\r",
            "param_type = 'Max damage per turn';\r",
            "}\r",
            "\r",
            "type = custom_type;\r",
            "}\r",
            "else if(type == t_Engine)\r",
            "{\r",
            "type = 'Engine';\r",
            "\r",
            "//Скорость\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.Engine.mSpeed');\r",
            "param=round(0.07 * GetParFromString(tstr, ',', GTL-1, 1) + 80 + GetParFromString(tstr, ',', GTL-1, 1));\r",
            "\r",
            "param_type = 'Engine speed';\r",
            "}\r",
            "//Прыжок\r",
            "else if(param == 2)\r",
            "{\r",
            "tstr=CT('Items.Engine.mJump');\r",
            "param=12 + GetParFromString(tstr, ',', GTL-1, 1);\r",
            "\r",
            "param_type = 'Jump range';\r",
            "}\r",
            "}\r",
            "else if(type==t_FuelTanks)\r",
            "{\r",
            "type='FuelTank';\r",
            "\r",
            "//Ёмкость\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.FuelTanks.mCapacity');\r",
            "param=round(0.20 * GetParFromString(tstr, ',', GTL-1, 1) + 5 + GetParFromString(tstr, ',', GTL-1, 1));\r",
            "\r",
            "param_type = 'Fuel capacity';\r",
            "}\r",
            "}\r",
            "else if(type==t_Radar)\r",
            "{\r",
            "type='Radar';\r",
            "\r",
            "//Дальность\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.Radar.mRadius');\r",
            "param=round(0.10 * GetParFromString(tstr, ',', GTL-1, 1) + 500 + GetParFromString(tstr, ',', GTL-1, 1));\r",
            "\r",
            "param_type = 'Radar range';\r",
            "}\r",
            "}\r",
            "else if(type==t_Scaner)\r",
            "{\r",
            "type='Scaner';\r",
            "\r",
            "//Дальность\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.DefGenerator.mDef');\r",
            "param=round(0.10 * (1 + GetParFromString(tstr, ',', GTL-1, 1)) + 7 + (1 + GetParFromString(tstr, ',', GTL-1, 1)));\r",
            "\r",
            "param_type = 'Scanner power';\r",
            "}\r",
            "}\r",
            "else if(type==t_RepairRobot)\r",
            "{\r",
            "type='Droid';\r",
            "\r",
            "//Эффективность\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.RepairRobot.mRepair');\r",
            "param=round(0.12 * GetParFromString(tstr, ',', GTL-1, 1) + 10 + GetParFromString(tstr, ',', GTL-1, 1));\r",
            "\r",
            "param_type = 'Droid efficiency';\r",
            "}\r",
            "}\r",
            "else if(type==t_CargoHook)\r",
            "{\r",
            "type='Hook';\r",
            "\r",
            "//Размер объектов\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.CargoHook.mMass');\r",
            "param=round(0.12 * GetParFromString(tstr, ',', GTL-1, 1) + 20 + GetParFromString(tstr, ',', GTL-1, 1));\r",
            "\r",
            "param_type = 'Hook max object size';\r",
            "}\r",
            "//Дальность\r",
            "else if(param == 2)\r",
            "{\r",
            "tstr=CT('Items.CargoHook.mRadius');\r",
            "param=25 + GetParFromString(tstr, ',', GTL-1, 1);\r",
            "\r",
            "param_type = 'Hook range';\r",
            "}\r",
            "//Макс. скорость (вблизи)\r",
            "else if(param == 3)\r",
            "{\r",
            "param=CT('Items.CargoHook.mSpeedClose');\r",
            "\r",
            "param_type = 'Hook close (max) speed';\r",
            "}\r",
            "//Мин. скорость (на удалении)\r",
            "else if(param == 4)\r",
            "{\r",
            "param=CT('Items.CargoHook.mSpeedFar');\r",
            "\r",
            "param_type = 'Hook far (min) speed';\r",
            "}\r",
            "}\r",
            "else if(type==t_DefGenerator)\r",
            "{\r",
            "type='DefGenerator';\r",
            "\r",
            "//Процент защиты\r",
            "if(param == 1)\r",
            "{\r",
            "tstr=CT('Items.DefGenerator.mDef');\r",
            "param=100.0 * GetParFromString(tstr, ',', GTL-1, 1) + 5;\r",
            "\r",
            "param_type = 'Defence percent';\r",
            "}\r",
            "}\r",
            "\r",
            "result='' + type + ',' + dam_type + ',' + param + ',' + param_type + ',' + shots_count + ',' + attacks_count + ',' + shot_type_check;\r",
            "}\r",
            "\r",
            "//Функция для проверки максимального/минимального значения бонусов/штрафов (выводит собранную информацию в игровой лог)\r",
            "//Для применения, вставьте в исполняемую строку следующую команду (переносы строк убирать не обязательно):\r",
            "// str itemType = t_DefGenerator;\r",
            "// str customWeaponType = '';\r",
            "// int parameterType = 1;\r",
            "// int parameterMaxValue = 50;\r",
            "// int parameterMinValue = 0;\r",
            "// int bonusType = bonDef;\r",
            "// int galaxyTechLevel = 8;\r",
            "// int isInstallMMs = 4;\r",
            "// int isInstallUniqueMMs = 1;\r",
            "// int isInstallAcrynator = 1;\r",
            "// int isInstallArtefacts = 1;\r",
            "// int isAppliedStimulantsAndDiseases = 1;\r",
            "// str skipAcrynsList = '*ExpTC_Lifeboat*ExpAcryn_DomAcryn*';\r",
            "// CheckParamRangeSingle(itemType, customWeaponType, galaxyTechLevel, parameterType, bonusType, p\r",
            "function CheckParamRangeSingle(str type, str custom_type, GTL, param, bonus, param_max_value, param_min_value, InstallMM, InstallUniqueMM, InstallAcrynator, InstallArtefacts, InstallStimulants, skipAcrynsList)\r",
            "{\r",
            "//Определяем базовый параметр оборудки с учётом максимального улучшения на НБ для указанного ГТУ\r",
            "type=SetBaseType(type, custom_type, GTL, param);\r",
            "\r",
            "str dam_type = GetParFromString(type, ',', 1, 1);\r",
            "param = GetParFromString(type, ',', 2, 1);\r",
            "str param_type = GetParFromString(type, ',', 3, 0);\r",
            "int shots_count = GetParFromString(type, ',', 4, 0);\r",
            "int attacks_count = GetParFromString(type, ',', 5, 0);\r",
            "int shot_type_check = GetParFromString(type, ',', 6, 0);\r",
            "type = GetParFromString(type, ',', 0, 1);\r",
            "\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT(' ');\r",
            "\r",
            "int excess_count=0;\r",
            "int highest_value=0;\r",
            "if(!param_max_value) highest_value=1000000000;\r",
            "str highest_value_name='None';\r",
            "str numInCfg;\r",
            "str numInCfgMM;\r",
            "int acrynat_value = 0;\r",
            "int max_MM_value = 0;\r",
            "int end_value = 0;\r",
            "int check = 0;\r",
            "int acryn_race_set = 0;\r",
            "int MM_race_set = 0;\r",
            "\r",
            "str checkedMM = '*';\r",
            "\r",
            "for(i = 0; i < BonusCount(); i = i + 1)\r",
            "{\r",
            "end_value = 0;\r",
            "acrynat_value = 0;\r",
            "\r",
            "numInCfg=BonusNumInCfg(i);\r",
            "//Пропускаем Акринатор\r",
            "if(numInCfg == '498')continue;\r",
            "//Исключаем не акрины\r",
            "if(!BonusIsSpecial(i))continue;\r",
            "//Исключаем уникальные микромодули\r",
            "if(CT('MicroModuls.'+numInCfg+'.UniqueMM'))continue;\r",
            "\r",
            "str equipOn=CT('MicroModuls.'+numInCfg+'.Equipments');\r",
            "\r",
            "//Исключаем бонусы, неподходящие для указанного ГТУ\r",
            "if(GTL < 8.0 * (0.01 * CT('MicroModuls.'+numInCfg+'.Priority')))continue;\r",
            "\r",
            "//Пропускаем скипнутые акрины\r",
            "if(findsubstr(skipAcrynsList, '*' + numInCfg + '*') > -1)continue;\r",
            "\r",
            "int uniqueMM_check = 0;\r",
            "\r",
            "//Переходим к проверке значения указанного параметра бонуса\r",
            "//Если для проверки выбрано максимальное значение параметра\r",
            "if(param_max_value)\r",
            "{\r",
            "//Исключаем акрины, значение искомого бонуса в которых не положительно\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "if(BonusValue(i, bonus) <= 0)continue;\r",
            "}\r",
            "else\r",
            "{\r",
            "if(BonusValue(i, bonus) <= 0 && ((BonusValue(i, bonShots) <= 0 && shot_type_check) || !shot_type_check) && BonusValue(i, bonAttacks) <= 0)continue;\r",
            "}\r",
            "\r",
            "if(CT('MicroModuls.'+numInCfg+'.BlockMM') != 1)\r",
            "{\r",
            "//Чистое значение данного акрина, без доп. бонусов\r",
            "check = 0;\r",
            "if(dam_type == 'NotWeapon')check = 1;\r",
            "else\r",
            "{\r",
            "tstr = CT('MicroModuls.'+numInCfg+'.Equipments');\r",
            "if(tstr == '')check = 1;\r",
            "else if(findsubstr(tstr, type) > -1 || findsubstr(tstr, dam_type) > -1 || tstr == 'Any')check = 1;\r",
            "}\r",
            "if(check)\r",
            "{\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "end_value = param + BonusValue(i, bonus);\r",
            "\r",
            "if(end_value > param_max_value)\r",
            "{\r",
            "SFT(numInCfg);\r",
            "SFT('Higher on: ' + (end_value - param_max_value));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(end_value > highest_value)\r",
            "{\r",
            "highest_value=end_value;\r",
            "highest_value_name=numInCfg;\r",
            "}\r",
            "\r",
            "excess_count=excess_count+1;\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "end_value = param + BonusValue(i, bonus);\r",
            "if(shot_type_check) end_value = end_value * (shots_count + BonusValue(i, bonShots));\r",
            "end_value = end_value * (attacks_count + BonusValue(i, bonAttacks));\r",
            "\r",
            "if(end_value > param_max_value)\r",
            "{\r",
            "SFT(numInCfg);\r",
            "SFT('Higher on: ' + (end_value - param_max_value));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(end_value > highest_value)\r",
            "{\r",
            "highest_value=end_value;\r",
            "highest_value_name=numInCfg;\r",
            "}\r",
            "\r",
            "excess_count=excess_count+1;\r",
            "}\r",
            "}\r",
            "}\r",
            "\r",
            "//\"Вставляем\" Акринатор\r",
            "if(InstallAcrynator && CT('MicroModuls.'+numInCfg+'.BlockMM') != 1)\r",
            "{\r",
            "//Если проверка не была запущена для корпуса или оружия\r",
            "if(type != 'Hull' && dam_type == 'NotWeapon')\r",
            "{\r",
            "if(findsubstr(equipOn, 'WEnergy') > -1)check = 1;\r",
            "else if(findsubstr(equipOn, 'WSplinter') > -1)check = 1;\r",
            "else if(findsubstr(equipOn, 'WMissile') > -1)check = 1;\r",
            "\r",
            "if(!check)\r",
            "{\r",
            "for(k=1; k<=18; k=k+1)\r",
            "{\r",
            "if(k <= 9)tstr='W0'+k;\r",
            "else tstr='W'+k;\r",
            "\r",
            "if(findsubstr(equipOn, tstr) > -1)\r",
            "{\r",
            "check=1;\r",
            "break;\r",
            "}\r",
            "}\r",
            "if(!check)\r",
            "{\r",
            "for(k=0; k<CustomWeaponTypes(); k=k+1)\r",
            "{\r",
            "tstr=CustomWeaponTypes(k);\r",
            "\r",
            "if(findsubstr(equipOn, tstr) > -1)\r",
            "{\r",
            "check=1;\r",
            "break;\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "if(findsubstr(equipOn, 'Hull') == -1 && !check)\r",
            "{\r",
            "acrynat_value = param + (3 * BonusValue(i, bonus));\r",
            "}\r",
            "\r",
            "//Проверяем, не превышает ли бонус акрина лимитное значение с установленным Акринатором\r",
            "if(acrynat_value > param_max_value && (3 * BonusValue(i, bonus)))\r",
            "{\r",
            "SFT(numInCfg + ' + Acrynator');\r",
            "SFT('Higher on: ' + (acrynat_value - param_max_value));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(acrynat_value > highest_value)\r",
            "{\r",
            "highest_value = acrynat_value;\r",
            "highest_value_name = numInCfg + ' + Acrynator';\r",
            "}\r",
            "\r",
            "excess_count=excess_count+1;\r",
            "}\r",
            "}\r",
            "}\r",
            "\r",
            "//Перебор ММ\r",
            "if(InstallMM && CT('MicroModuls.'+numInCfg+'.BlockMM') != 1)\r",
            "{\r",
            "for(k=0; k<BonusCount(); k=k+1)\r",
            "{\r",
            "max_MM_value = 0;\r",
            "numInCfgMM=BonusNumInCfg(k);\r",
            "\r",
            "//Исключаем ММ, значение искомого бонуса в которых не положительно\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "if(BonusValue(k, bonus) <= 0)continue;\r",
            "}\r",
            "else\r",
            "{\r",
            "if(BonusValue(k, bonus) <= 0 && ((BonusValue(k, bonShots) <= 0 && shot_type_check) || !shot_type_check) && BonusValue(k, bonAttacks) <= 0)continue;\r",
            "}\r",
            "\r",
            "//Исключаем акрины\r",
            "uniqueMM_check = CT('MicroModuls.'+numInCfgMM+'.UniqueMM');\r",
            "if(BonusIsSpecial(k))\r",
            "{\r",
            "if(uniqueMM_check)\r",
            "{\r",
            "if(!InstallUniqueMM)continue;\r",
            "}\r",
            "else continue;\r",
            "}\r",
            "\r",
            "//Пропускаем уровни ММ, которые были отсечены фильтром\r",
            "if(!uniqueMM_check)\r",
            "{\r",
            "//Оставляем только ММ первого уровня\r",
            "if(InstallMM == 1)\r",
            "{\r",
            "if(BonusPriority(k) > 30)continue;\r",
            "}\r",
            "//Оставляем только ММ второго уровня\r",
            "else if(InstallMM == 2)\r",
            "{\r",
            "if(BonusPriority(k) < 31 || BonusPriority(k) > 69)continue;\r",
            "}\r",
            "//Оставляем только ММ третьего уровня\r",
            "else if(InstallMM == 3)\r",
            "{\r",
            "if(BonusPriority(k) < 70)continue;\r",
            "}\r",
            "}\r",
            "\r",
            "//Проверяем на предмет совместимости с объектом поиска (оборудкой, имеющей подходящие параметры) сперва сам ММ\r",
            "tstr = CT('MicroModuls.'+numInCfgMM+'.Equipments');\r",
            "if(findsubstr(tstr, type) == -1 && findsubstr(tstr, dam_type) == -1 && tstr != 'Any' && tstr != '')continue;\r",
            "\r",
            "//После чего проверяем, не превышает ли собственный бонус данного ММ лимитное значение даже без учёта акрина\r",
            "if(findsubstr(checkedMM, '*' + numInCfgMM + '*') == -1)\r",
            "{\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "max_MM_value = param + BonusValue(k, bonus);\r",
            "}\r",
            "else\r",
            "{\r",
            "max_MM_value = param + BonusValue(k, bonus);\r",
            "if(shot_type_check) max_MM_value = max_MM_value * (shots_count + BonusValue(k, bonShots));\r",
            "max_MM_value = max_MM_value * (attacks_count + BonusValue(k, bonAttacks));\r",
            "}\r",
            "\r",
            "if(max_MM_value > param_max_value)\r",
            "{\r",
            "SFT('None + ' + numInCfgMM);\r",
            "SFT('Higher on: ' + (max_MM_value - param_max_value));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(max_MM_value > highest_value)\r",
            "{\r",
            "highest_value = max_MM_value;\r",
            "highest_value_name = 'None + ' + numInCfgMM;\r",
            "}\r",
            "\r",
            "checkedMM = checkedMM + numInCfgMM + '*';\r",
            "excess_count=excess_count+1;\r",
            "}\r",
            "}\r",
            "\r",
            "//А затем и акрин\r",
            "tstr = CT('MicroModuls.'+numInCfg+'.Equipments');\r",
            "if(findsubstr(tstr, type) == -1 && findsubstr(tstr, dam_type) == -1 && tstr != 'Any' && tstr != '')continue;\r",
            "\r",
            "//Затем делаем общую проверку на соответствие типа акрина типу ММ\r",
            "tstr = CT('MicroModuls.'+numInCfgMM+'.Equipments');\r",
            "if(findsubstr(tstr, type) == -1 && findsubstr(tstr, dam_type) == -1 && tstr != 'Any' && tstr != '')continue;\r",
            "\r",
            "//Далее переходим к проверке соответствия конкретных рас бонусов\r",
            "//Определяем сет рас для акрина\r",
            "acryn_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfg+'.Owner'), 'Acryn');\r",
            "\r",
            "//Определяем сет рас для ММ\r",
            "MM_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfgMM+'.Owner'), 'MM');\r",
            "\r",
            "//Сравниваем полученные сеты\r",
            "if(!(acryn_race_set & MM_race_set))continue;\r",
            "\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "max_MM_value = param + BonusValue(i, bonus) + BonusValue(k, bonus);\r",
            "}\r",
            "else\r",
            "{\r",
            "max_MM_value = param + BonusValue(i, bonus) + BonusValue(k, bonus);\r",
            "if(shot_type_check) max_MM_value = max_MM_value * (shots_count + BonusValue(i, bonShots) + BonusValue(k, bonShots));\r",
            "max_MM_value = max_MM_value * (attacks_count + BonusValue(i, bonAttacks) + BonusValue(k, bonAttacks));\r",
            "}\r",
            "\r",
            "if(max_MM_value > param_max_value)\r",
            "{\r",
            "SFT(numInCfg + ' + ' + numInCfgMM);\r",
            "SFT('Higher on: ' + (max_MM_value - param_max_value));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(max_MM_value > highest_value)\r",
            "{\r",
            "highest_value = max_MM_value;\r",
            "highest_value_name = numInCfg + ' + ' + numInCfgMM;\r",
            "}\r",
            "\r",
            "excess_count = excess_count + 1;\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "//Если для проверки выбрано минимальное значение параметра\r",
            "else\r",
            "{\r",
            "//Исключаем акрины, значение искомого бонуса в которых не отрицательно\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "if(BonusValue(i, bonus) >= 0)continue;\r",
            "}\r",
            "else\r",
            "{\r",
            "if(BonusValue(i, bonus) >= 0 && ((BonusValue(i, bonShots) >= 0 && shot_type_check) || !shot_type_check) && BonusValue(i, bonAttacks) >= 0)continue;\r",
            "}\r",
            "\r",
            "if(CT('MicroModuls.' + numInCfg + '.BlockMM') != 1)\r",
            "{\r",
            "//Чистое значение данного акрина, без доп. бонусов\r",
            "check = 0;\r",
            "if(dam_type == 'NotWeapon') check = 1;\r",
            "else\r",
            "{\r",
            "tstr = CT('MicroModuls.' + numInCfg + '.Equipments');\r",
            "if(tstr == '') check = 1;\r",
            "else if(findsubstr(tstr, type) > -1 || findsubstr(tstr, dam_type) > -1 || tstr == 'Any')check = 1;\r",
            "}\r",
            "if(check)\r",
            "{\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "end_value = param + BonusValue(i, bonus);\r",
            "}\r",
            "else\r",
            "{\r",
            "end_value = param + BonusValue(i, bonus);\r",
            "if(shot_type_check)\r",
            "{\r",
            "tint = shots_count + BonusValue(i, bonShots);\r",
            "if(tint < 1) tint = 1;\r",
            "end_value = end_value * tint;\r",
            "}\r",
            "tint = shots_count + BonusValue(i, bonAttacks);\r",
            "if(tint < 1) tint = 1;\r",
            "end_value = end_value * tint;\r",
            "}\r",
            "\r",
            "if(end_value < param_min_value)\r",
            "{\r",
            "SFT(numInCfg);\r",
            "SFT('Lower on: ' + abs(abs(param_min_value) - abs(end_value)));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(end_value < highest_value)\r",
            "{\r",
            "highest_value=end_value;\r",
            "highest_value_name=numInCfg;\r",
            "}\r",
            "\r",
            "excess_count = excess_count + 1;\r",
            "}\r",
            "}\r",
            "\r",
            "//Перебор ММ\r",
            "if(InstallMM && CT('MicroModuls.' + numInCfg + '.BlockMM') != 1)\r",
            "{\r",
            "for(k = 0; k < BonusCount(); k = k + 1)\r",
            "{\r",
            "max_MM_value = 0;\r",
            "numInCfgMM = BonusNumInCfg(k);\r",
            "\r",
            "//Исключаем ММ, значение искомого бонуса которых не отрицательно\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "if(BonusValue(k, bonus) >= 0)continue;\r",
            "}\r",
            "else\r",
            "{\r",
            "if(BonusValue(k, bonus) >= 0 && ((BonusValue(k, bonShots) >= 0 && shot_type_check) || !shot_type_check) && BonusValue(k, bonAttacks) >= 0)continue;\r",
            "}\r",
            "\r",
            "//Исключаем акрины\r",
            "uniqueMM_check = CT('MicroModuls.'+numInCfgMM+'.UniqueMM');\r",
            "if(BonusIsSpecial(k))\r",
            "{\r",
            "if(uniqueMM_check)\r",
            "{\r",
            "if(!InstallUniqueMM)continue;\r",
            "}\r",
            "else continue;\r",
            "}\r",
            "\r",
            "//Пропускаем уровни ММ, которые были отсечены фильтром\r",
            "if(!uniqueMM_check)\r",
            "{\r",
            "//Оставляем только ММ первого уровня\r",
            "if(InstallMM == 1)\r",
            "{\r",
            "if(BonusPriority(k) > 30)continue;\r",
            "}\r",
            "//Оставляем только ММ второго уровня\r",
            "else if(InstallMM == 2)\r",
            "{\r",
            "if(BonusPriority(k) < 31 || BonusPriority(k) > 69)continue;\r",
            "}\r",
            "//Оставляем только ММ третьего уровня\r",
            "else if(InstallMM == 3)\r",
            "{\r",
            "if(BonusPriority(k) < 70)continue;\r",
            "}\r",
            "}\r",
            "\r",
            "//Проверяем на предмет совместимости с объектом поиска (оборудкой, имеющей подходящие параметры) сперва сам ММ\r",
            "tstr = CT('MicroModuls.' + numInCfgMM + '.Equipments');\r",
            "if(findsubstr(tstr, type) == -1 && findsubstr(tstr, dam_type) == -1 && tstr != 'Any' && tstr != '')continue;\r",
            "\r",
            "//После чего проверяем, не превышает ли собственный бонус данного ММ лимитное значение даже без учёта акрина\r",
            "if(findsubstr(checkedMM, '*' + numInCfgMM + '*') == -1)\r",
            "{\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "max_MM_value = param + BonusValue(k, bonus);\r",
            "}\r",
            "else\r",
            "{\r",
            "max_MM_value = param + BonusValue(k, bonus);\r",
            "if(shot_type_check)\r",
            "{\r",
            "tint = shots_count + BonusValue(k, bonShots);\r",
            "if(tint < 1) tint = 1;\r",
            "max_MM_value = max_MM_value * tint;\r",
            "}\r",
            "tint = shots_count + BonusValue(k, bonAttacks);\r",
            "if(tint < 1) tint = 1;\r",
            "max_MM_value = max_MM_value * tint;\r",
            "}\r",
            "\r",
            "if(max_MM_value < param_min_value)\r",
            "{\r",
            "SFT('None + ' + numInCfgMM);\r",
            "SFT('Lower on: ' + abs(abs(param_min_value) - abs(max_MM_value)));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(max_MM_value < highest_value)\r",
            "{\r",
            "highest_value = max_MM_value;\r",
            "highest_value_name = 'None + ' + numInCfgMM;\r",
            "}\r",
            "\r",
            "checkedMM = checkedMM + numInCfgMM + '*';\r",
            "excess_count=excess_count+1;\r",
            "}\r",
            "}\r",
            "\r",
            "//А затем и акрин\r",
            "tstr = CT('MicroModuls.'+numInCfg+'.Equipments');\r",
            "if(findsubstr(tstr, type) == -1 && findsubstr(tstr, dam_type) == -1 && tstr != 'Any' && tstr != '')continue;\r",
            "\r",
            "//Затем делаем общую проверку на соответствие типа акрина типу ММ\r",
            "tstr = CT('MicroModuls.'+numInCfgMM+'.Equipments');\r",
            "if(findsubstr(tstr, type) == -1 && findsubstr(tstr, dam_type) == -1 && tstr != 'Any' && tstr != '')continue;\r",
            "\r",
            "//Далее переходим к проверке соответствия конкретных рас бонусов\r",
            "//Определяем сет рас для акрина\r",
            "acryn_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfg+'.Owner'), 'Acryn');\r",
            "\r",
            "//Определяем сет рас для ММ\r",
            "MM_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfgMM+'.Owner'), 'MM');\r",
            "\r",
            "//Сравниваем полученные сеты\r",
            "if(!(acryn_race_set & MM_race_set))continue;\r",
            "\r",
            "\r",
            "if(param_type != 'Max damage per turn')\r",
            "{\r",
            "max_MM_value = param + BonusValue(i, bonus) + BonusValue(k, bonus);\r",
            "}\r",
            "else\r",
            "{\r",
            "max_MM_value = param + BonusValue(i, bonus) + BonusValue(k, bonus);\r",
            "if(shot_type_check)\r",
            "{\r",
            "tint = shots_count + BonusValue(i, bonShots) + BonusValue(k, bonShots);\r",
            "if(tint < 1) tint = 1;\r",
            "max_MM_value = max_MM_value * tint;\r",
            "}\r",
            "tint = shots_count + BonusValue(i, bonAttacks) + BonusValue(k, bonAttacks);\r",
            "if(tint < 1) tint = 1;\r",
            "max_MM_value = max_MM_value * tint;\r",
            "}\r",
            "\r",
            "if(max_MM_value < param_min_value)\r",
            "{\r",
            "SFT(numInCfg + ' + ' + numInCfgMM);\r",
            "SFT('Lower on: ' + abs(abs(param_min_value) - abs(max_MM_value)));\r",
            "SFT('---------------------');\r",
            "\r",
            "if(max_MM_value < highest_value)\r",
            "{\r",
            "highest_value = max_MM_value;\r",
            "highest_value_name = numInCfg + ' + ' + numInCfgMM;\r",
            "}\r",
            "\r",
            "excess_count=excess_count+1;\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "\r",
            "SFT(' ');\r",
            "SFT('Galaxy tech level: ' + GTL);\r",
            "SFT('Param type: ' + param_type);\r",
            "SFT('Base value: ' + param);\r",
            "if(param_max_value) SFT('The highest value: ' + highest_value_name + ' (' + highest_value + ')');\r",
            "else SFT('The lowest value: ' + highest_value_name + ' (' + highest_value + ')');\r",
            "SFT('Total excesses: ' + excess_count);\r",
            "\r",
            "SFT(' ');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "}\r",
            "\r",
            "//Функция для проверки максимального/минимального значения бонусов/штрафов в составе всех возможных наборов оборудки (выводит собранную информацию в игровой лог)\r",
            "//Для применения, вставьте в исполняемую строку следующую команду (переносы строк убирать не обязательно):\r",
            "// str itemType = t_DefGenerator;\r",
            "// str customWeaponType = '';\r",
            "// int parameterType = 1;\r",
            "// int bonusType = bonDef;\r",
            "// int galaxyTechLevel = 8;\r",
            "// int isInstallMMs = 2;\r",
            "// int isInstallUniqueMMs = 1;\r",
            "// int isInstallAcrynator = 1;\r",
            "// int isInstallArtefacts = 1;\r",
            "// int isAppliedStimulantsAndDiseases = 1;\r",
            "// \r",
            "// CheckParamRangeInSet(itemType, customWeaponType, galaxyTechLevel, parameterType, bonusType, isInstallMMs, isInstallUniqueMMs, isInstallAcrynator, isInstallArtefacts, isAppliedStimulantsAndDiseases, skipAcrynsList);\r",
            "function CheckParamRangeInSet(str type, str custom_type, GTL, param, bonus, InstallMM, InstallUniqueMM, InstallAcrynator, InstallArtefacts, InstallStimulants, skipAcrynsList)\r",
            "{\r",
            "//Определяем базовый параметр оборудки с учётом максимального улучшения на НБ для указанного ГТУ\r",
            "type=SetBaseType(type, custom_type, GTL, param);\r",
            "\r",
            "str dam_type = GetParFromString(type, ',', 1, 1);\r",
            "param = GetParFromString(type, ',', 2, 1);\r",
            "str param_type = GetParFromString(type, ',', 3, 0);\r",
            "int shots_count = GetParFromString(type, ',', 4, 0);\r",
            "int attacks_count = GetParFromString(type, ',', 5, 0);\r",
            "int shot_type_check = GetParFromString(type, ',', 6, 0);\r",
            "type = GetParFromString(type, ',', 0, 1);\r",
            "\r",
            "str cur_search_type = type;\r",
            "\r",
            "str w_type;\r",
            "//Проверяем, ищем ли мы информацию по оружию\r",
            "if(type == 'Hull') w_type = 'None';\r",
            "else if(type == 'Engine') w_type = 'None';\r",
            "else if(type == 'FuelTank') w_type = 'None';\r",
            "else if(type == 'Radar') w_type = 'None';\r",
            "else if(type == 'Scaner') w_type = 'None';\r",
            "else if(type == 'Droid') w_type = 'None';\r",
            "else if(type == 'Hook') w_type = 'None';\r",
            "else if(type == 'DefGenerator') w_type = 'None';\r",
            "else w_type = type;\r",
            "\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT(' ');\r",
            "\r",
            "int highest_hull = 0;\r",
            "str highest_hull_name = 'None';\r",
            "int hull_best_MM = -1;\r",
            "\r",
            "int highest_gun1 = 0;\r",
            "str highest_gun1_name = 'None';\r",
            "int gun1_best_MM = -1;\r",
            "\r",
            "int highest_gun2 = 0;\r",
            "str highest_gun2_name = 'None';\r",
            "int gun2_best_MM = -1;\r",
            "\r",
            "int highest_gun3 = 0;\r",
            "str highest_gun3_name = 'None';\r",
            "int gun3_best_MM = -1;\r",
            "\r",
            "int highest_gun4 = 0;\r",
            "str highest_gun4_name = 'None';\r",
            "int gun4_best_MM = -1;\r",
            "\r",
            "int highest_gun5 = 0;\r",
            "str highest_gun5_name = 'None';\r",
            "int gun5_best_MM = -1;\r",
            "\r",
            "int highest_engine = 0;\r",
            "str highest_engine_name = 'None';\r",
            "int engine_best_MM = -1;\r",
            "\r",
            "int highest_fuel = 0;\r",
            "str highest_fuel_name = 'None';\r",
            "int fuel_best_MM = -1;\r",
            "\r",
            "int highest_radar = 0;\r",
            "str highest_radar_name = 'None';\r",
            "int radar_best_MM = -1;\r",
            "\r",
            "int highest_scanner = 0;\r",
            "str highest_scanner_name = 'None';\r",
            "int scanner_best_MM = -1;\r",
            "\r",
            "int highest_droid = 0;\r",
            "str highest_droid_name = 'None';\r",
            "int droid_best_MM = -1;\r",
            "\r",
            "int highest_hook = 0;\r",
            "str highest_hook_name = 'None';\r",
            "int hook_best_MM = -1;\r",
            "\r",
            "int highest_def = 0;\r",
            "str highest_def_name = 'None';\r",
            "int def_best_MM = -1;\r",
            "\r",
            "int check;\r",
            "int excess_count=0;\r",
            "int highest_value;\r",
            "str highest_value_name;\r",
            "str temp_w_type = 'None';\r",
            "str end_w_type = 'None';\r",
            "int acryn_param = 0;\r",
            "int best_MM = -1;\r",
            "int best_MM_end = -1;\r",
            "int best_MM_value;\r",
            "str numInCfgMM;\r",
            "str uniqueMM_list = '*';\r",
            "int acryn_race_set = 0;\r",
            "int MM_race_set = 0;\r",
            "int trion_count = 0;\r",
            "str numInCfg;\r",
            "int roll_counts;\r",
            "\r",
            "for(j=1; j<=9; j=j+1)\r",
            "{\r",
            "roll_counts = 1;\r",
            "\r",
            "if(j == 1)type='Hull';\r",
            "else if(j == 2)\r",
            "{\r",
            "type='Weapon';\r",
            "if(w_type == 'None')roll_counts = 5;\r",
            "}\r",
            "else if(j == 3) type='Engine';\r",
            "else if(j == 4) type='FuelTank';\r",
            "else if(j == 5) type='Radar';\r",
            "else if(j == 6) type='Scaner';\r",
            "else if(j == 7) type='Droid';\r",
            "else if(j == 8) type='Hook';\r",
            "else if(j == 9) type='DefGenerator';\r",
            "\r",
            "while(roll_counts)\r",
            "{\r",
            "highest_value = 0;\r",
            "highest_value_name = 'None';\r",
            "best_MM = -1;\r",
            "best_MM_end = -1;\r",
            "best_MM_value = 0;\r",
            "\r",
            "for(i = 0; i < BonusCount(); i = i + 1)\r",
            "{\r",
            "numInCfg = BonusNumInCfg(i);\r",
            "//Пропускаем Акринатор\r",
            "if(numInCfg == '498')continue;\r",
            "//Пропускаем ММ\r",
            "if(!BonusIsSpecial(i))continue;\r",
            "//Исключаем уникальные микромодули\r",
            "if(CT('MicroModuls.'+numInCfg+'.UniqueMM'))continue;\r",
            "\r",
            "//Пропускаем скипнутые акрины\r",
            "if(findsubstr(skipAcrynsList, '*' + numInCfg + '*') > -1)continue;\r",
            "\r",
            "//Исключаем бонусы, неподходящие для указанного ГТУ\r",
            "if(GTL < 8.0*(0.01*CT('MicroModuls.'+numInCfg+'.Priority')))continue;\r",
            "\r",
            "//Исключаем бонусы, неподходящие для текущего оборудования/оружия\r",
            "str equipOn=CT('MicroModuls.'+numInCfg+'.Equipments');\r",
            "if(equipOn != 'Any' && equipOn != '')\r",
            "{\r",
            "if(type != 'Weapon')\r",
            "{\r",
            "if(findsubstr(equipOn, type) == -1)continue;\r",
            "}\r",
            "//Перебираем все возможные типы орудий\r",
            "else\r",
            "{\r",
            "check=0;\r",
            "\r",
            "//Если проверяем случайный оружейный акрин в поисках бонуса для оборудки\r",
            "if(w_type == 'None')\r",
            "{\r",
            "temp_w_type = 'None';\r",
            "\r",
            "if(findsubstr(equipOn, 'WEnergy') > -1)\r",
            "{\r",
            "dam_type = 'WEnergy';\r",
            "check = 1;\r",
            "}\r",
            "else if(findsubstr(equipOn, 'WSplinter') > -1)\r",
            "{\r",
            "dam_type = 'WSplinter';\r",
            "check = 1;\r",
            "}\r",
            "else if(findsubstr(equipOn, 'WMissile') > -1)\r",
            "{\r",
            "dam_type = 'WMissile';\r",
            "check = 1;\r",
            "}\r",
            "\r",
            "if(!check)\r",
            "{\r",
            "for(k=1; k<=18; k=k+1)\r",
            "{\r",
            "if(k <= 9)temp_w_type='W0'+k;\r",
            "else temp_w_type='W'+k;\r",
            "\r",
            "if(findsubstr(equipOn, temp_w_type) > -1)\r",
            "{\r",
            "check=1;\r",
            "break;\r",
            "}\r",
            "}\r",
            "if(!check)\r",
            "{\r",
            "for(k=0; k<CustomWeaponTypes(); k=k+1)\r",
            "{\r",
            "temp_w_type=CustomWeaponTypes(k);\r",
            "\r",
            "if(findsubstr(equipOn, temp_w_type) > -1)\r",
            "{\r",
            "check=1;\r",
            "break;\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "}\r",
            "//Если проверяем акрин конкретного оружия в поисках бонуса для оружия\r",
            "else\r",
            "{\r",
            "if(findsubstr(equipOn, w_type) > -1)check=1;\r",
            "else if(findsubstr(equipOn, dam_type) > -1)check=1;\r",
            "}\r",
            "\r",
            "if(!check)continue;\r",
            "}\r",
            "}\r",
            "\r",
            "//Если в сете применено уже как минимум три трионки, пропускаем все остальные\r",
            "if(trion_count >= 3)\r",
            "{\r",
            "if(!findsubstr(numInCfg, 'ExpAcryn_'))continue;\r",
            "}\r",
            "\r",
            "//Перебор ММ\r",
            "if(InstallMM && CT('MicroModuls.'+numInCfg+'.BlockMM') != 1)\r",
            "{\r",
            "int uniqueMM_check = 0;\r",
            "int uniqueMM_end_check = 0;\r",
            "for(k=0; k<BonusCount(); k=k+1)\r",
            "{\r",
            "numInCfgMM = BonusNumInCfg(k);\r",
            "\r",
            "//Исключаем акрины и уникальные ММ (если стоит маркер)\r",
            "uniqueMM_check = 0;\r",
            "uniqueMM_check = CT('MicroModuls.'+numInCfgMM+'.UniqueMM');\r",
            "//А если маркер на исключение уникальных ММ не стоит, то запоминаем, является ли данный ММ уникальным\r",
            "if(InstallUniqueMM)\r",
            "{\r",
            "if(BonusIsSpecial(k))continue;\r",
            "//Пропускаем уникальные ММ, которые уже были использованы в данном сете\r",
            "else if(uniqueMM_check == 1)\r",
            "{\r",
            "if(findsubstr(uniqueMM_list, '*' + numInCfgMM + '*') > -1)continue;\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(BonusIsSpecial(k))\r",
            "{\r",
            "if(uniqueMM_check)continue;\r",
            "}\r",
            "}\r",
            "\r",
            "//Пропускаем уровни ММ, которые были отсечены фильтром\r",
            "if(!uniqueMM_check)\r",
            "{\r",
            "//Оставляем только ММ первого уровня\r",
            "if(InstallMM == 1)\r",
            "{\r",
            "if(BonusPriority(k) > 30)continue;\r",
            "}\r",
            "//Оставляем только ММ второго уровня\r",
            "else if(InstallMM == 2)\r",
            "{\r",
            "if(BonusPriority(k) < 31 || BonusPriority(k) > 69)continue;\r",
            "}\r",
            "//Оставляем только ММ третьего уровня\r",
            "else if(InstallMM == 3)\r",
            "{\r",
            "if(BonusPriority(k) < 70)continue;\r",
            "}\r",
            "}\r",
            "\r",
            "//Проверяем возможность установки ММ на данный акрин оборудки\r",
            "if(type != 'Weapon')\r",
            "{\r",
            "tstr = CT('MicroModuls.'+numInCfgMM+'.Equipments');\r",
            "\r",
            "//Сперва делаем общую проверку на соответствие типа акрина типу ММ\r",
            "if(findsubstr(tstr, type) == -1 && tstr != 'Any' && tstr != '')continue;\r",
            "//Далее переходим к проверке соответствия конкретных рас бонусов\r",
            "else\r",
            "{\r",
            "//Определяем сет рас для акрина\r",
            "acryn_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfg+'.Owner'), 'Acryn');\r",
            "\r",
            "//Определяем сет рас для ММ\r",
            "MM_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfgMM+'.Owner'), 'MM');\r",
            "\r",
            "//Сравниваем полученные сеты\r",
            "if(!(acryn_race_set & MM_race_set))continue;\r",
            "}\r",
            "}\r",
            "//Проверяем возможность установки ММ на данный акрин оружия\r",
            "else\r",
            "{\r",
            "tstr = CT('MicroModuls.'+numInCfgMM+'.Equipments');\r",
            "//Сперва делаем общую проверку на соответствие типа акрина типу ММ\r",
            "check = 0;\r",
            "if(findsubstr(tstr, temp_w_type) == -1 && findsubstr(tstr, 'dam_type') == -1 && tstr != 'Any' && tstr != '')\r",
            "{\r",
            "//Если конкретное оружие мы не ищем, то подойдёт ММ на любую пушку\r",
            "if(temp_w_type != 'None')continue;\r",
            "else if(findsubstr(tstr, 'WEnergy') == -1 && findsubstr(tstr, 'WSplinter') == -1 && findsubstr(tstr, 'WMissile') == -1)continue;\r",
            "else check = 1;\r",
            "}\r",
            "//Далее переходим к проверке соответствия конкретных рас бонусов\r",
            "if(check)\r",
            "{\r",
            "//Определяем сет рас для акрина\r",
            "acryn_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfg+'.Owner'), 'Acryn');\r",
            "\r",
            "//Определяем сет рас для ММ\r",
            "MM_race_set = RaceSetDefine(CT('MicroModuls.'+numInCfgMM+'.Owner'), 'MM');\r",
            "\r",
            "//Сравниваем полученные сеты\r",
            "if(!(acryn_race_set & MM_race_set))continue;\r",
            "}\r",
            "}\r",
            "\r",
            "tint = BonusValue(k, bonus);\r",
            "if(tint > best_MM_value)\r",
            "{\r",
            "best_MM_value = tint;\r",
            "best_MM = k;\r",
            "\r",
            "if(uniqueMM_check == 1)uniqueMM_end_check = 1;\r",
            "else uniqueMM_end_check = 0;\r",
            "}\r",
            "}\r",
            "\r",
            "//Делаем пометку, что уникальный микромодуль уже был применён в данном сете оборудки\r",
            "if(uniqueMM_end_check)uniqueMM_list = uniqueMM_list + numInCfgMM + '*';\r",
            "}\r",
            "\r",
            "tint = BonusValue(i, bonus);\r",
            "if(!InstallAcrynator || type == 'Hull' || type == 'Weapon' || CT('MicroModuls.'+numInCfg+'.BlockMM') == 1)\r",
            "{\r",
            "if((tint + best_MM_value) > highest_value)\r",
            "{\r",
            "if(tint > 0)\r",
            "{\r",
            "highest_value = tint;\r",
            "highest_value_name = numInCfg;\r",
            "if(type == 'Weapon')\r",
            "{\r",
            "if(temp_w_type != 'None')end_w_type = temp_w_type;\r",
            "else end_w_type = w_type;\r",
            "}\r",
            "}\r",
            "best_MM_end = best_MM;\r",
            "}\r",
            "}\r",
            "//Вставляем Акринатор, если был выставлен соответствующий маркер\r",
            "else\r",
            "{\r",
            "if((3 * tint) > highest_value)\r",
            "{\r",
            "//Даже если акрин с ММ окажется лучше акрина с акринатором, запоминаем значение бонуса с акринатором на случай подстановки акринатора в другой акрин\r",
            "if((3 * tint) > (tint + best_MM_value) || type != cur_search_type)\r",
            "{\r",
            "if(tint)\r",
            "{\r",
            "highest_value = (3 * tint);\r",
            "highest_value_name = numInCfg + ' + Acrynator';\r",
            "}\r",
            "best_MM_end = best_MM;\r",
            "}\r",
            "else\r",
            "{\r",
            "if(tint)\r",
            "{\r",
            "highest_value = tint;\r",
            "highest_value_name = numInCfg;\r",
            "}\r",
            "best_MM_end = best_MM;\r",
            "}\r",
            "}\r",
            "}\r",
            "\r",
            "best_MM_value = 0;\r",
            "}\r",
            "\r",
            "//Считаем трионку, попавшую в сет\r",
            "if(!findsubstr(highest_value_name, 'ExpAcryn_'))\r",
            "{\r",
            "trion_count = trion_count + 1;\r",
            "}\r",
            "\r",
            "if(j == 1)\r",
            "{\r",
            "highest_hull=highest_value;\r",
            "highest_hull_name=highest_value_name;\r",
            "hull_best_MM = best_MM_end;\r",
            "}\r",
            "else if(j == 2)\r",
            "{\r",
            "if(roll_counts == 5)\r",
            "{\r",
            "highest_gun5=highest_value;\r",
            "highest_gun5_name=highest_value_name;\r",
            "gun5_best_MM = best_MM_end;\r",
            "}\r",
            "else if(roll_counts == 4)\r",
            "{\r",
            "highest_gun4=highest_value;\r",
            "highest_gun4_name=highest_value_name;\r",
            "gun4_best_MM = best_MM_end;\r",
            "}\r",
            "else if(roll_counts == 3)\r",
            "{\r",
            "highest_gun3=highest_value;\r",
            "highest_gun3_name=highest_value_name;\r",
            "gun3_best_MM = best_MM_end;\r",
            "}\r",
            "else if(roll_counts == 2)\r",
            "{\r",
            "highest_gun2=highest_value;\r",
            "highest_gun2_name=highest_value_name;\r",
            "gun2_best_MM = best_MM_end;\r",
            "}\r",
            "else if(roll_counts == 1)\r",
            "{\r",
            "highest_gun1=highest_value;\r",
            "highest_gun1_name=highest_value_name;\r",
            "gun1_best_MM = best_MM_end;\r",
            "}\r",
            "}\r",
            "else if(j == 3)\r",
            "{\r",
            "highest_engine=highest_value;\r",
            "highest_engine_name=highest_value_name;\r",
            "engine_best_MM = best_MM_end;\r",
            "}\r",
            "else if(j == 4)\r",
            "{\r",
            "highest_fuel=highest_value;\r",
            "highest_fuel_name=highest_value_name;\r",
            "fuel_best_MM = best_MM_end;\r",
            "}\r",
            "else if(j == 5)\r",
            "{\r",
            "highest_radar=highest_value;\r",
            "highest_radar_name=highest_value_name;\r",
            "radar_best_MM = best_MM_end;\r",
            "}\r",
            "else if(j == 6)\r",
            "{\r",
            "highest_scanner=highest_value;\r",
            "highest_scanner_name=highest_value_name;\r",
            "scanner_best_MM = best_MM_end;\r",
            "}\r",
            "else if(j == 7)\r",
            "{\r",
            "highest_droid=highest_value;\r",
            "highest_droid_name=highest_value_name;\r",
            "droid_best_MM = best_MM_end;\r",
            "}\r",
            "else if(j == 8)\r",
            "{\r",
            "highest_hook=highest_value;\r",
            "highest_hook_name=highest_value_name;\r",
            "hook_best_MM = best_MM_end;\r",
            "}\r",
            "else if(j == 9)\r",
            "{\r",
            "highest_def=highest_value;\r",
            "highest_def_name=highest_value_name;\r",
            "def_best_MM = best_MM_end;\r",
            "}\r",
            "\r",
            "roll_counts = roll_counts - 1;\r",
            "}\r",
            "}\r",
            "\r",
            "//Определяем, какой акрин получает наибольший плюс от установки Акринатора\r",
            "int acr_check = 0;\r",
            "\r",
            "int t_highest_engine = 0;\r",
            "int t_highest_fuel = 0;\r",
            "int t_highest_radar = 0;\r",
            "int t_highest_scanner = 0;\r",
            "int t_highest_droid = 0;\r",
            "int t_highest_hook = 0;\r",
            "int t_highest_def = 0;\r",
            "\r",
            "if(findsubstr(highest_engine_name, ' + Acrynator') > -1)t_highest_engine = highest_engine;\r",
            "if(findsubstr(highest_fuel_name, ' + Acrynator') > -1)t_highest_fuel = highest_fuel;\r",
            "if(findsubstr(highest_radar_name, ' + Acrynator') > -1)t_highest_radar = highest_radar;\r",
            "if(findsubstr(highest_scanner_name, ' + Acrynator') > -1)t_highest_scanner = highest_scanner;\r",
            "if(findsubstr(highest_droid_name, ' + Acrynator') > -1)t_highest_droid = highest_droid;\r",
            "if(findsubstr(highest_hook_name, ' + Acrynator') > -1)t_highest_hook = highest_hook;\r",
            "if(findsubstr(highest_def_name, ' + Acrynator') > -1)t_highest_def = highest_def;\r",
            "\r",
            "highest_value = max(t_highest_engine, t_highest_fuel, t_highest_radar, t_highest_scanner, t_highest_droid, t_highest_hook, t_highest_def);\r",
            "if(!highest_value)highest_value = -1;\r",
            "\r",
            "SFT('Galaxy tech level: ' + GTL);\r",
            "SFT('Parameter type: ' + param_type);\r",
            "SFT('Base parameter value: ' + param);\r",
            "SFT(' ');\r",
            "\r",
            "//Корпус\r",
            "if(hull_best_MM > -1 && cur_search_type == 'Hull')\r",
            "{\r",
            "SFT('Hull: '+highest_hull_name+' + '+BonusNumInCfg(hull_best_MM)+' ('+(highest_hull + BonusValue(hull_best_MM, bonus))+')');\r",
            "param = param + BonusValue(hull_best_MM, bonus);\r",
            "}\r",
            "else SFT('Hull: '+highest_hull_name+' ('+highest_hull+')');\r",
            "param = param + highest_hull;\r",
            "//Пушки\r",
            "if(w_type == 'None')\r",
            "{\r",
            "// if(gun1_best_MM > -1)\r",
            "// {\r",
            "// SFT('Weapon 1: '+highest_gun1_name+' + '+BonusNumInCfg(gun1_best_MM)+' ('+(highest_gun1 + BonusValue(gun1_best_MM, bonus))+')');\r",
            "// param = param + BonusValue(gun1_best_MM, bonus);\r",
            "// }\r",
            "// else\r",
            "SFT('Weapon 1: '+highest_gun1_name+' ('+highest_gun1+')');\r",
            "param = param + highest_gun1;\r",
            "\r",
            "// if(gun2_best_MM > -1)\r",
            "// {\r",
            "// SFT('Weapon 2: '+highest_gun2_name+' + '+BonusNumInCfg(gun2_best_MM)+' ('+(highest_gun2 + BonusValue(gun2_best_MM, bonus))+')');\r",
            "// param = param + BonusValue(gun2_best_MM, bonus);\r",
            "// }\r",
            "// else\r",
            "SFT('Weapon 2: '+highest_gun2_name+' ('+highest_gun2+')');\r",
            "param = param + highest_gun2;\r",
            "\r",
            "// if(gun3_best_MM > -1)\r",
            "// {\r",
            "// SFT('Weapon 3: '+highest_gun3_name+' + '+BonusNumInCfg(gun3_best_MM)+' ('+(highest_gun3 + BonusValue(gun3_best_MM, bonus))+')');\r",
            "// param = param + BonusValue(gun3_best_MM, bonus);\r",
            "// }\r",
            "// else\r",
            "SFT('Weapon 3: '+highest_gun3_name+' ('+highest_gun3+')');\r",
            "param = param + highest_gun3;\r",
            "\r",
            "// if(gun4_best_MM > -1)\r",
            "// {\r",
            "// SFT('Weapon 4: '+highest_gun4_name+' + '+BonusNumInCfg(gun4_best_MM)+' ('+(highest_gun4 + BonusValue(gun4_best_MM, bonus))+')');\r",
            "// param = param + BonusValue(gun4_best_MM, bonus);\r",
            "// }\r",
            "// else\r",
            "SFT('Weapon 4: '+highest_gun4_name+' ('+highest_gun4+')');\r",
            "param = param + highest_gun4;\r",
            "\r",
            "// if(gun5_best_MM > -1)\r",
            "// {\r",
            "// SFT('Weapon 5: '+highest_gun5_name+' + '+BonusNumInCfg(gun5_best_MM)+' ('+(highest_gun5 + BonusValue(gun5_best_MM, bonus))+')');\r",
            "// param = param + BonusValue(gun5_best_MM, bonus);\r",
            "// }\r",
            "// else\r",
            "SFT('Weapon 5: '+highest_gun5_name+' ('+highest_gun5+')');\r",
            "param = param + highest_gun5;\r",
            "}\r",
            "else\r",
            "{\r",
            "if(gun1_best_MM > -1)\r",
            "{\r",
            "SFT('Weapon '+end_w_type+': '+highest_gun1_name+' + '+BonusNumInCfg(gun1_best_MM)+' ('+(highest_gun1 + BonusValue(gun1_best_MM, bonus))+')');\r",
            "param = param + BonusValue(gun1_best_MM, bonus);\r",
            "}\r",
            "else SFT('Weapon '+end_w_type+': '+highest_gun1_name+' ('+highest_gun1+')');\r",
            "param = param + highest_gun1;\r",
            "}\r",
            "//Двигатель\r",
            "if(!acr_check && highest_engine == highest_value)\r",
            "{\r",
            "tint = 0;\r",
            "if(engine_best_MM > -1)tint = BonusValue(engine_best_MM, bonus);\r",
            "\r",
            "if(findsubstr(highest_engine_name, ' + Acrynator') > -1)\r",
            "{\r",
            "if(highest_engine > (highest_engine / 3 + tint))\r",
            "{\r",
            "SFT('Engine: '+highest_engine_name+' ('+highest_engine+')');\r",
            "acr_check = 1;\r",
            "}\r",
            "//Если значение акрина с ММ выше, чем значение акрина с Акринатором\r",
            "else\r",
            "{\r",
            "highest_engine_name = substr(highest_engine_name, 0, findsubstr(highest_engine_name, ' + Acrynator'));\r",
            "highest_engine = highest_engine / 3;\r",
            "\r",
            "if(engine_best_MM > -1 && cur_search_type == 'Engine')\r",
            "{\r",
            "SFT('Engine: '+highest_engine_name+' + '+BonusNumInCfg(engine_best_MM)+' ('+(highest_engine + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Engine: '+highest_engine_name+' ('+highest_engine+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(engine_best_MM > -1 && cur_search_type == 'Engine')\r",
            "{\r",
            "SFT('Engine: '+highest_engine_name+' + '+BonusNumInCfg(engine_best_MM)+' ('+(highest_engine + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Engine: '+highest_engine_name+' ('+highest_engine+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(findsubstr(highest_engine_name, ' + Acrynator') > -1)\r",
            "{\r",
            "highest_engine_name = substr(highest_engine_name, 0, findsubstr(highest_engine_name, ' + Acrynator'));\r",
            "highest_engine = highest_engine / 3;\r",
            "\r",
            "if(engine_best_MM > -1 && cur_search_type == 'Engine')\r",
            "{\r",
            "SFT('Engine: '+highest_engine_name+' + '+BonusNumInCfg(engine_best_MM)+' ('+(highest_engine + BonusValue(engine_best_MM, bonus))+')');\r",
            "param = param + BonusValue(engine_best_MM, bonus);\r",
            "}\r",
            "else SFT('Engine: '+highest_engine_name+' ('+highest_engine+')');\r",
            "}\r",
            "else\r",
            "{\r",
            "if(engine_best_MM > -1 && cur_search_type == 'Engine')\r",
            "{\r",
            "SFT('Engine: '+highest_engine_name+' + '+BonusNumInCfg(engine_best_MM)+' ('+(highest_engine + BonusValue(engine_best_MM, bonus))+')');\r",
            "param = param + BonusValue(engine_best_MM, bonus);\r",
            "}\r",
            "else SFT('Engine: '+highest_engine_name+' ('+highest_engine+')');\r",
            "}\r",
            "}\r",
            "param = param + highest_engine;\r",
            "//Топливный бак\r",
            "if(!acr_check && highest_fuel == highest_value)\r",
            "{\r",
            "tint = 0;\r",
            "if(fuel_best_MM > -1)tint = BonusValue(fuel_best_MM, bonus);\r",
            "\r",
            "if(findsubstr(highest_fuel_name, ' + Acrynator') > -1)\r",
            "{\r",
            "if(highest_fuel > (highest_fuel / 3 + tint))\r",
            "{\r",
            "SFT('FuelTank: '+highest_fuel_name+' ('+highest_fuel+')');\r",
            "acr_check = 1;\r",
            "}\r",
            "//Если значение акрина с ММ выше, чем значение акрина с Акринатором\r",
            "else\r",
            "{\r",
            "highest_fuel_name = substr(highest_fuel_name, 0, findsubstr(highest_fuel_name, ' + Acrynator'));\r",
            "highest_fuel = highest_fuel / 3;\r",
            "\r",
            "if(fuel_best_MM > -1 && cur_search_type == 'FuelTank')\r",
            "{\r",
            "SFT('FuelTank: '+highest_fuel_name+' + '+BonusNumInCfg(fuel_best_MM)+' ('+(highest_fuel + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('FuelTank: '+highest_fuel_name+' ('+highest_fuel+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(fuel_best_MM > -1 && cur_search_type == 'FuelTank')\r",
            "{\r",
            "SFT('FuelTank: '+highest_fuel_name+' + '+BonusNumInCfg(fuel_best_MM)+' ('+(highest_fuel + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('FuelTank: '+highest_fuel_name+' ('+highest_fuel+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(findsubstr(highest_fuel_name, ' + Acrynator') > -1)\r",
            "{\r",
            "highest_fuel_name = substr(highest_fuel_name, 0, findsubstr(highest_fuel_name, ' + Acrynator'));\r",
            "highest_fuel = highest_fuel / 3;\r",
            "\r",
            "if(fuel_best_MM > -1 && cur_search_type == 'FuelTank')\r",
            "{\r",
            "SFT('FuelTank: '+highest_fuel_name+' + '+BonusNumInCfg(fuel_best_MM)+' ('+(highest_fuel + BonusValue(fuel_best_MM, bonus))+')');\r",
            "param = param + BonusValue(fuel_best_MM, bonus);\r",
            "}\r",
            "else SFT('FuelTank: '+highest_fuel_name+' ('+highest_fuel+')');\r",
            "}\r",
            "else\r",
            "{\r",
            "if(fuel_best_MM > -1 && cur_search_type == 'FuelTank')\r",
            "{\r",
            "SFT('FuelTank: '+highest_fuel_name+' + '+BonusNumInCfg(fuel_best_MM)+' ('+(highest_fuel + BonusValue(fuel_best_MM, bonus))+')');\r",
            "param = param + BonusValue(fuel_best_MM, bonus);\r",
            "}\r",
            "else SFT('FuelTank: '+highest_fuel_name+' ('+highest_fuel+')');\r",
            "}\r",
            "}\r",
            "param = param + highest_fuel;\r",
            "//Радар\r",
            "if(!acr_check && highest_radar == highest_value)\r",
            "{\r",
            "tint = 0;\r",
            "if(radar_best_MM > -1)tint = BonusValue(radar_best_MM, bonus);\r",
            "\r",
            "if(findsubstr(highest_radar_name, ' + Acrynator') > -1)\r",
            "{\r",
            "if(highest_radar > (highest_radar / 3 + tint))\r",
            "{\r",
            "SFT('Radar: '+highest_radar_name+' ('+highest_radar+')');\r",
            "acr_check = 1;\r",
            "}\r",
            "//Если значение акрина с ММ выше, чем значение акрина с Акринатором\r",
            "else\r",
            "{\r",
            "highest_radar_name = substr(highest_radar_name, 0, findsubstr(highest_radar_name, ' + Acrynator'));\r",
            "highest_radar = highest_radar / 3;\r",
            "\r",
            "if(radar_best_MM > -1 && cur_search_type == 'Radar')\r",
            "{\r",
            "SFT('Radar: '+highest_radar_name+' + '+BonusNumInCfg(radar_best_MM)+' ('+(highest_radar + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Radar: '+highest_radar_name+' ('+highest_radar+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(radar_best_MM > -1 && cur_search_type == 'Radar')\r",
            "{\r",
            "SFT('Radar: '+highest_radar_name+' + '+BonusNumInCfg(radar_best_MM)+' ('+(highest_radar + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Radar: '+highest_radar_name+' ('+highest_radar+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(findsubstr(highest_radar_name, ' + Acrynator') > -1)\r",
            "{\r",
            "highest_radar_name = substr(highest_radar_name, 0, findsubstr(highest_radar_name, ' + Acrynator'));\r",
            "highest_radar = highest_radar / 3;\r",
            "\r",
            "if(radar_best_MM > -1 && cur_search_type == 'Radar')\r",
            "{\r",
            "SFT('Radar: '+highest_radar_name+' + '+BonusNumInCfg(radar_best_MM)+' ('+(highest_radar + BonusValue(radar_best_MM, bonus))+')');\r",
            "param = param + BonusValue(radar_best_MM, bonus);\r",
            "}\r",
            "else SFT('Radar: '+highest_radar_name+' ('+highest_radar+')');\r",
            "}\r",
            "else\r",
            "{\r",
            "if(radar_best_MM > -1 && cur_search_type == 'Radar')\r",
            "{\r",
            "SFT('Radar: '+highest_radar_name+' + '+BonusNumInCfg(radar_best_MM)+' ('+(highest_radar + BonusValue(radar_best_MM, bonus))+')');\r",
            "param = param + BonusValue(radar_best_MM, bonus);\r",
            "}\r",
            "else SFT('Radar: '+highest_radar_name+' ('+highest_radar+')');\r",
            "}\r",
            "}\r",
            "param = param + highest_radar;\r",
            "//Сканер\r",
            "if(!acr_check && highest_scanner == highest_value)\r",
            "{\r",
            "tint = 0;\r",
            "if(scanner_best_MM > -1)tint = BonusValue(scanner_best_MM, bonus);\r",
            "\r",
            "if(findsubstr(highest_scanner_name, ' + Acrynator') > -1)\r",
            "{\r",
            "if(highest_scanner > (highest_scanner / 3 + tint))\r",
            "{\r",
            "SFT('Scanner: '+highest_scanner_name+' ('+highest_scanner+')');\r",
            "acr_check = 1;\r",
            "}\r",
            "//Если значение акрина с ММ выше, чем значение акрина с Акринатором\r",
            "else\r",
            "{\r",
            "highest_scanner_name = substr(highest_scanner_name, 0, findsubstr(highest_scanner_name, ' + Acrynator'));\r",
            "highest_scanner = highest_scanner / 3;\r",
            "\r",
            "if(scanner_best_MM > -1 && cur_search_type == 'Scaner')\r",
            "{\r",
            "SFT('Scanner: '+highest_scanner_name+' + '+BonusNumInCfg(scanner_best_MM)+' ('+(highest_scanner + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Scanner: '+highest_scanner_name+' ('+highest_scanner+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(scanner_best_MM > -1 && cur_search_type == 'Scaner')\r",
            "{\r",
            "SFT('Scanner: '+highest_scanner_name+' + '+BonusNumInCfg(scanner_best_MM)+' ('+(highest_scanner + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Scanner: '+highest_scanner_name+' ('+highest_scanner+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(findsubstr(highest_scanner_name, ' + Acrynator') > -1)\r",
            "{\r",
            "highest_scanner_name = substr(highest_scanner_name, 0, findsubstr(highest_scanner_name, ' + Acrynator'));\r",
            "highest_scanner = highest_scanner / 3;\r",
            "\r",
            "if(scanner_best_MM > -1 && cur_search_type == 'Scaner')\r",
            "{\r",
            "SFT('Scanner: '+highest_scanner_name+' + '+BonusNumInCfg(scanner_best_MM)+' ('+(highest_scanner + BonusValue(scanner_best_MM, bonus))+')');\r",
            "param = param + BonusValue(scanner_best_MM, bonus);\r",
            "}\r",
            "else SFT('Scanner: '+highest_scanner_name+' ('+highest_scanner+')');\r",
            "}\r",
            "else\r",
            "{\r",
            "if(scanner_best_MM > -1 && cur_search_type == 'Scaner')\r",
            "{\r",
            "SFT('Scanner: '+highest_scanner_name+' + '+BonusNumInCfg(scanner_best_MM)+' ('+(highest_scanner + BonusValue(scanner_best_MM, bonus))+')');\r",
            "param = param + BonusValue(scanner_best_MM, bonus);\r",
            "}\r",
            "else SFT('Scanner: '+highest_scanner_name+' ('+highest_scanner+')');\r",
            "}\r",
            "}\r",
            "param = param + highest_scanner;\r",
            "//Дроид\r",
            "if(!acr_check && highest_droid == highest_value)\r",
            "{\r",
            "tint = 0;\r",
            "if(droid_best_MM > -1)tint = BonusValue(droid_best_MM, bonus);\r",
            "\r",
            "if(findsubstr(highest_droid_name, ' + Acrynator') > -1)\r",
            "{\r",
            "if(highest_droid > (highest_droid / 3 + tint))\r",
            "{\r",
            "SFT('Droid: '+highest_droid_name+' ('+highest_droid+')');\r",
            "acr_check = 1;\r",
            "}\r",
            "//Если значение акрина с ММ выше, чем значение акрина с Акринатором\r",
            "else\r",
            "{\r",
            "highest_droid_name = substr(highest_droid_name, 0, findsubstr(highest_droid_name, ' + Acrynator'));\r",
            "highest_droid = highest_droid / 3;\r",
            "\r",
            "if(droid_best_MM > -1 && cur_search_type == 'Droid')\r",
            "{\r",
            "SFT('Droid: '+highest_droid_name+' + '+BonusNumInCfg(droid_best_MM)+' ('+(highest_droid + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Droid: '+highest_droid_name+' ('+highest_droid+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(droid_best_MM > -1 && cur_search_type == 'Droid')\r",
            "{\r",
            "SFT('Droid: '+highest_droid_name+' + '+BonusNumInCfg(droid_best_MM)+' ('+(highest_droid + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Droid: '+highest_droid_name+' ('+highest_droid+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(findsubstr(highest_droid_name, ' + Acrynator') > -1)\r",
            "{\r",
            "highest_droid_name = substr(highest_droid_name, 0, findsubstr(highest_droid_name, ' + Acrynator'));\r",
            "highest_droid = highest_droid / 3;\r",
            "\r",
            "if(droid_best_MM > -1 && cur_search_type == 'Droid')\r",
            "{\r",
            "SFT('Droid: '+highest_droid_name+' + '+BonusNumInCfg(droid_best_MM)+' ('+(highest_droid + BonusValue(droid_best_MM, bonus))+')');\r",
            "param = param + BonusValue(droid_best_MM, bonus);\r",
            "}\r",
            "else SFT('Droid: '+highest_droid_name+' ('+highest_droid+')');\r",
            "}\r",
            "else\r",
            "{\r",
            "if(droid_best_MM > -1 && cur_search_type == 'Droid')\r",
            "{\r",
            "SFT('Droid: '+highest_droid_name+' + '+BonusNumInCfg(droid_best_MM)+' ('+(highest_droid + BonusValue(droid_best_MM, bonus))+')');\r",
