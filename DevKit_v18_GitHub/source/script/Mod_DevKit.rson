            "{\r",
            "SFT('Hook: '+highest_hook_name+' + '+BonusNumInCfg(hook_best_MM)+' ('+(highest_hook + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('Hook: '+highest_hook_name+' ('+highest_hook+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(findsubstr(highest_hook_name, ' + Acrynator') > -1)\r",
            "{\r",
            "highest_hook_name = substr(highest_hook_name, 0, findsubstr(highest_hook_name, ' + Acrynator'));\r",
            "highest_hook = highest_hook / 3;\r",
            "\r",
            "if(hook_best_MM > -1 && cur_search_type == 'Hook')\r",
            "{\r",
            "SFT('Hook: '+highest_hook_name+' + '+BonusNumInCfg(hook_best_MM)+' ('+(highest_hook + BonusValue(hook_best_MM, bonus))+')');\r",
            "param = param + BonusValue(hook_best_MM, bonus);\r",
            "}\r",
            "else SFT('Hook: '+highest_hook_name+' ('+highest_hook+')');\r",
            "}\r",
            "else\r",
            "{\r",
            "if(hook_best_MM > -1 && cur_search_type == 'Hook')\r",
            "{\r",
            "SFT('Hook: '+highest_hook_name+' + '+BonusNumInCfg(hook_best_MM)+' ('+(highest_hook + BonusValue(hook_best_MM, bonus))+')');\r",
            "param = param + BonusValue(hook_best_MM, bonus);\r",
            "}\r",
            "else SFT('Hook: '+highest_hook_name+' ('+highest_hook+')');\r",
            "}\r",
            "}\r",
            "param = param + highest_hook;\r",
            "//ГЗП\r",
            "if(!acr_check && highest_def == highest_value)\r",
            "{\r",
            "tint = 0;\r",
            "if(def_best_MM > -1)tint = BonusValue(def_best_MM, bonus);\r",
            "\r",
            "if(findsubstr(highest_def_name, ' + Acrynator') > -1)\r",
