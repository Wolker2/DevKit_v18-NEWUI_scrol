        {
          "Type": "Top",
          "Name": "Answer 67",
          "Pos.x": 1080,
          "Pos.y": 2500,
          "Parent": 205,
          "#": 206,
          "Total.Lines": 70,
          "Code.Type": "Turn",
          "Code": [
            "    //Накладываем на корпус серию \"Идеал\"\r",
            "    HullSeries(ShipItems(Player(),0),FindSeriesByName(CT('HullType.99.Name')));\r",
            "    //Выдаём чит-двигатель\r",
            "    temp_gift=CreateEquipment(t_Engine,0,8,Gaal);\r",
            "    ShipSpecialBonuses(Player(),bonJump,ShipSpecialBonuses(Player(),bonJump)+1000);\r",
            "    ItemCost(temp_gift,(ItemCost(temp_gift)/2));\r",
            "    temp_int=GetEquipmentStats(temp_gift,0)*20;\r",
            "    SetEquipmentStats(temp_gift,temp_int,0);\r",
            "    SetEquipmentStats(temp_gift,125,1);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1);\r",
            "    //Выдаём чит-радар\r",
            "    temp_gift=CreateEquipment(t_Radar,0,8,Gaal);\r",
            "    ItemCost(temp_gift,(ItemCost(temp_gift)/2));\r",
            "    SetEquipmentStats(temp_gift,32000,0);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1);\r",
            "    ShipFuel(Player(),50000);\r",
            "    for(temp_int = 0; temp_int < GalaxySectors(); temp_int = temp_int + 1)\r",
            "    {\r",
            "        if(!SectorVisible(GalaxySectors(temp_int))) SectorVisible(GalaxySectors(temp_int), 1);\r",
            "    }\r",
            "    ItemSize(ShipItems(Player(), 0), 1200);\r",
            "    HullHP(Player(), 'To100');\r",
            "    ShipRepairEq(Player());\r",
            "    ShipMoney(Player(), ShipMoney(Player()) + 3000000);\r",
            "    //Выдаём чит-сканер\r",
            "    temp_gift=CreateEquipment(t_Scaner,1,8,Gaal);\r",
            "    SetEquipmentStats(temp_gift,125,0);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1);\r",
            "    //Выдаём прочую крутую оборудку\r",
            "    if(ShipWeapon(Player(),1))FreeItem(GetItemFromShip(Player(),FindItemInShip(Player(),ShipWeapon(Player(),1))));\r",
            "    temp_gift=CreateEquipment(t_Weapon14,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1,1);\r",
            "    if(ShipWeapon(Player(),2))FreeItem(GetItemFromShip(Player(),FindItemInShip(Player(),ShipWeapon(Player(),2))));\r",
            "    temp_gift=CreateEquipment(t_Weapon14,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1,2);\r",
            "    if(ShipWeapon(Player(),3))FreeItem(GetItemFromShip(Player(),FindItemInShip(Player(),ShipWeapon(Player(),3))));\r",
            "    temp_gift=CreateEquipment(t_Weapon14,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1,3);\r",
            "    if(ShipWeapon(Player(),4))FreeItem(GetItemFromShip(Player(),FindItemInShip(Player(),ShipWeapon(Player(),4))));\r",
            "    temp_gift=CreateEquipment(t_Weapon14,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1,4);\r",
            "    if(ShipWeapon(Player(),5))FreeItem(GetItemFromShip(Player(),FindItemInShip(Player(),ShipWeapon(Player(),5))));\r",
            "    temp_gift=CreateEquipment(t_Weapon14,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1,5);\r",
            "    temp_gift=CreateEquipment(t_RepairRobot,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1);\r",
            "    temp_gift=CreateEquipment(t_DefGenerator,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1);\r",
            "    temp_gift=CreateEquipment(t_CargoHook,1,8,Gaal);\r",
            "    AddItemToShip(Player(),temp_gift);\r",
            "    ItemIsInUse(temp_gift,Player(),1);\r",
            "    //Добавляем в трюм читерный исследовательский зонд\r",
            "    temp_gift = CreateZond(5, 6, 255, 255, 255);\r",
            "    ItemSize(temp_gift, 1);\r",
            "    SetName(temp_gift, 'Overseer');\r",
            "    AddItemToShip(Player(), temp_gift);\r",
            "    \r",
            "    Sound('Sound.Buy');\r",
            "    DChange(0);\r",
            "    exit;\r"
          ]
        },
