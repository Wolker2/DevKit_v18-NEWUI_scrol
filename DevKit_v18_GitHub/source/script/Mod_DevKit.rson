            "    \r",
            "    for(i = 1; i <= 3; i = i + 1)\r",
            "    {\r",
            "        if(i == 1) tdwd = CreateQuestItem('Quark_bomb', PirateClan);\r",
            "        else if(i == 2) tdwd = CreateQuestItem('Stun_bomb', PirateClan);\r",
            "        else tdwd = CreateQuestItem('EMP_bomb', PirateClan);\r",
            "        AddItemToShip(Player(), tdwd);\r",
