        {
          "Type": "Top",
          "Name": "Answer 69",
          "Pos.x": 360,
          "Pos.y": 2600,
          "Parent": 209,
          "#": 210,
          "Total.Lines": 21,
          "Code.Type": "Turn",
          "Code": [
            "    for(i = 0; i <= 3; i = i + 1)\r",
            "    {\r",
            "        int size = CustomArtSizeCalc(int(CT('Artefacts.CustomArtefacts.' + GetValueFromScript('Mod_ExpArts', 'CustomArtsLangNames', i) + '.Size')));\r",
