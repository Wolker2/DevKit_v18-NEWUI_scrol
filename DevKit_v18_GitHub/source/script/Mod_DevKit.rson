            "{\r",
            "SFT('DefGenerator: '+highest_def_name+' ('+highest_def+')');\r",
            "acr_check = 1;\r",
            "}\r",
            "//Если значение акрина с ММ выше, чем значение акрина с Акринатором\r",
            "else\r",
            "{\r",
            "highest_def_name = substr(highest_def_name, 0, findsubstr(highest_def_name, ' + Acrynator'));\r",
            "highest_def = highest_def / 3;\r",
            "\r",
            "if(def_best_MM > -1 && cur_search_type == 'DefGenerator')\r",
            "{\r",
            "SFT('DefGenerator: '+highest_def_name+' + '+BonusNumInCfg(def_best_MM)+' ('+(highest_def + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('DefGenerator: '+highest_def_name+' ('+highest_def+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(def_best_MM > -1 && cur_search_type == 'DefGenerator')\r",
            "{\r",
            "SFT('DefGenerator: '+highest_def_name+' + '+BonusNumInCfg(def_best_MM)+' ('+(highest_def + tint)+')');\r",
            "param = param + tint;\r",
            "}\r",
            "else SFT('DefGenerator: '+highest_def_name+' ('+highest_def+')');\r",
            "}\r",
            "}\r",
            "else\r",
            "{\r",
            "if(findsubstr(highest_def_name, ' + Acrynator') > -1)\r",
            "{\r",
            "highest_def_name = substr(highest_def_name, 0, findsubstr(highest_def_name, ' + Acrynator'));\r",
            "highest_def = highest_def / 3;\r",
            "\r",
            "if(def_best_MM > -1 && cur_search_type == 'DefGenerator')\r",
            "{\r",
            "SFT('DefGenerator: '+highest_def_name+' + '+BonusNumInCfg(def_best_MM)+' ('+(highest_def + BonusValue(def_best_MM, bonus))+')');\r",
            "param = param + BonusValue(def_best_MM, bonus);\r",
            "}\r",
            "else SFT('DefGenerator: '+highest_def_name+' ('+highest_def+')');\r",
            "}\r",
            "else\r",
            "{\r",
            "if(def_best_MM > -1 && cur_search_type == 'DefGenerator')\r",
            "{\r",
            "SFT('DefGenerator: '+highest_def_name+' + '+BonusNumInCfg(def_best_MM)+' ('+(highest_def + BonusValue(def_best_MM, bonus))+')');\r",
            "param = param + BonusValue(def_best_MM, bonus);\r",
            "}\r",
            "else SFT('DefGenerator: '+highest_def_name+' ('+highest_def+')');\r",
            "}\r",
            "}\r",
            "param = param + highest_def;\r",
            "\r",
            "SFT(' ');\r",
            "\r",
            "//Применяем бонусы от артефактов\r",
            "int art_dam_bon = 0;\r",
            "if(InstallArtefacts)\r",
            "{\r",
            "if(param_type == 'Hull armor')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactHull') + CT('Artefacts.NumericValues.kArtefactHullEx');\r",
            "SFT('Iron Zoopie max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "}\r",
            "else if(param_type == 'Hull mass')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactAntigrav') + CT('Artefacts.NumericValues.kArtefactAntigravEx');\r",
            "SFT('Antigravitazer max bonus: -' + tint + '%');\r",
            "param = param + tint;\r",
            "}\r",
            "else if(param_type == 'Max damage')\r",
            "{\r",
            "if(dam_type == 'WEnergy')\r",
            "{\r",
            "tint = round(100.0 * CT('Artefacts.NumericValues.kArtDefToEnergyUp') + CT('Artefacts.NumericValues.kArtDefToEnergyUpEx'));\r",
            "SFT('Proportionar max bonus: ' + (tint - 100) + '% (applied AFTER passing through a target\\'s shield)');\r",
            "art_dam_bon = tint - 100;\r",
            "}\r",
            "else if(dam_type == 'WSplinter')\r",
            "{\r",
            "tint = round(100.0 * CT('Artefacts.NumericValues.kArtefactSpeed') + CT('Artefacts.NumericValues.kArtefactSpeedEx'));\r",
            "SFT('Screw-on max bonus: ' + (tint - 100) + '% (applied AFTER passing through a target\\'s shield)');\r",
            "art_dam_bon = tint - 100;\r",
            "}\r",
            "}\r",
            "else if(param_type == 'Max damage per turn')\r",
            "{\r",
            "if(dam_type == 'WMissile')\r",
            "{\r",
            "SFT('Rals max bonus: ~30% (in total)');\r",
            "param = (param * 30)/100;\r",
            "}\r",
            "}\r",
            "else if(param_type == 'Engine speed')\r",
            "{\r",
            "//Сопланатор (применяет свой бонус до пси-ускорителя)\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtWeaponToSpeed') + CT('Artefacts.NumericValues.kArtWeaponToSpeedEx');\r",
            "SFT('Nozzlenator max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "\r",
            "//Пси-ускоритель\r",
            "tint = round(100.0 * CT('Artefacts.NumericValues.kArtefactSpeed') + CT('Artefacts.NumericValues.kArtefactSpeedEx'));\r",
            "SFT('Matter Psi-Accelerator max bonus: ' + (tint - 100) + '%');\r",
            "param = (param * tint)/100;\r",
            "}\r",
            "else if(param_type == 'Radar range')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactRadar') + CT('Artefacts.NumericValues.kArtefactRadarEx');\r",
            "SFT('Prolonger max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "}\r",
            "else if(param_type == 'Scanner power')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactScaner') + CT('Artefacts.NumericValues.kArtefactScanerEx');\r",
            "SFT('Scanner Cache max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "}\r",
            "else if(param_type == 'Droid efficiency')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactDroid') + CT('Artefacts.NumericValues.kArtefactDroidEx');\r",
            "SFT('Junior Droid max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "}\r",
            "else if(param_type == 'Hook max object size')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactHook') + CT('Artefacts.NumericValues.kArtefactHookEx');\r",
            "SFT('Erimeter max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "}\r",
            "else if(param_type == 'Hook range')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactHookRaduis') + CT('Artefacts.NumericValues.kArtefactHookRaduisEx');\r",
            "SFT('Erimeter max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "}\r",
            "else if(param_type == 'Hook close (max) speed' || param_type == 'Hook far (min) speed')\r",
            "{\r",
            "tint = 0 + CT('Artefacts.NumericValues.kArtefactHookSpeed') + CT('Artefacts.NumericValues.kArtefactHookSpeedEx');\r",
            "SFT('Erimeter max bonus: ' + tint);\r",
            "param = param + tint;\r",
            "}\r",
            "}\r",
            "\r",
            "//Применяем бонусы от стимуляторов и болезней\r",
            "if(InstallStimulants)\r",
            "{\r",
            "// if(param_type == 'Hull mass')\r",
            "// {\r",
            "// SFT('Grand Malosausus debuff: +20%');\r",
            "// param = param + 20;\r",
            "// }\r",
            "if(param_type == 'Engine speed')\r",
            "{\r",
            "//Гаалистра времени\r",
            "SFT('Gaalian Alacrity bonus: +30%');\r",
            "param = round(1.3 * param);\r",
            "}\r",
            "else if(param_type == 'Radar range')\r",
            "{\r",
            "//Психотропный кэш\r",
            "SFT('Psychotropic Cache bonus: +100%');\r",
            "param = param * 2;\r",
            "}\r",
            "else if(param_type == 'Scanner power')\r",
            "{\r",
            "//Психотропный кэш\r",
            "SFT('Psychotropic Cache bonus: +12');\r",
            "param = param + 12;\r",
            "}\r",
            "}\r",
            "\r",
            "if(!art_dam_bon) SFT('Total parameter value: ' + param);\r",
            "else SFT('Total parameter value: ' + param + ' ' + art_dam_bon + '% (after passing through a target\\'s shield)');\r",
            "\r",
            "SFT(' ');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "}\r",
            "\r",
            "unknown MM_PointsStatsArr = newarray(1);\r",
            "ArrayDelete(MM_PointsStatsArr, 0);\r",
            "ArrayAdd(MM_PointsStatsArr, 3000, 'UniqueMM_Points');\r",
            "ArrayAdd(MM_PointsStatsArr, 2.2, 'Level1_Coef');\r",
            "ArrayAdd(MM_PointsStatsArr, 1.6, 'Level2_Coef');\r",
            "ArrayAdd(MM_PointsStatsArr, 1.0, 'Level3_Coef');\r",
            "\r",
            "//Сперва суммируем все эти модификаторы, а затем вычитаем обнаруженные, по мере разбора строки Owner в бонусе\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0350, 'Maloc');\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0450, 'Peleng');\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0500, 'People');\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0575, 'Fei');\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0650, 'Gaal');\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0400, 'PirateClan');\r",
            "//По умолчанию присутствуют в любом списке, где заведомо не отключены через NonKling, либо не ограничены через перечисление серий\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0500, 'Blazer');\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0500, 'Keller');\r",
            "ArrayAdd(MM_PointsStatsArr, 0.0500, 'Terron');\r",
            "//По умолчанию неизвестной расы ни в одном списке овнеров нет\r",
            "ArrayAdd(MM_PointsStatsArr, 0.4500, 'None');\r",
            "//Враждебные кастомные расы считаем относительно значений серий доминаторов (в данном случае силу клисан считаем равной сразу двум сериям)\r",
            "ArrayAdd(MM_PointsStatsArr, 0.1000, 'Klissan');\r",
            "\r",
            "function FindUnbalancedMMs()\r",
            "{\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT(' ');\r",
            "\r",
            "for(int i = 0; i < BonusCount(); i = i + 1)\r",
            "{\r",
            "str bonus_section = BonusNumInCfg(i);\r",
            "\r",
            "//Отсеиваем акрины и запоминаем уникальные ММ\r",
            "int uniqueMM = 0;\r",
            "if(int(CT('MicroModuls.' + bonus_section + '.Special')) == 1)\r",
            "{\r",
            "uniqueMM = CT('MicroModuls.' + bonus_section + '.uniqueMM');\r",
            "if(!uniqueMM) continue;\r",
            "}\r",
            "\r",
            "if(uniqueMM == 1) int total_points = MM_PointsStatsArr['UniqueMM_Points'];\r",
            "else\r",
            "{\r",
            "if(BonusPriority(i) <= 30) float level_coef = MM_PointsStatsArr['Level1_Coef'];\r",
            "else if(BonusPriority(i) <= 69) level_coef = MM_PointsStatsArr['Level2_Coef'];\r",
            "else level_coef = MM_PointsStatsArr['Level3_Coef'];\r",
            "total_points = (100 - BonusPriority(i)) * 5 * level_coef + 400;\r",
            "}\r",
            "\r",
            "float add_coef = 1.0;\r",
            "str owners_str = CT('MicroModuls.' + bonus_section + '.Owner');\r",
            "if(owners_str != '' && owners_str != 'Any')\r",
            "{\r",
            "int cnt = ParsCountFromString(owners_str, ',');\r",
            "for(int j = 0; j < cnt; j = j + 1)\r",
            "{\r",
            "str owner_par = GetParFromString(owners_str, ',', j, 1);\r",
            "if(owner_par == 'None') add_coef = add_coef - 0.45;\r",
            "}\r",
            "}\r",
            "\r",
            "total_points = round(add_coef * total_points);\r",
            "\r",
            "}\r",
            "\r",
            "SFT(' ');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "SFT('###########################');\r",
            "}\r",
            "",
            "function g_DevKitSetPage(page)",
            "{",
            "CustomInterfaceState('DevKit_Page_0', page == 0);",
            "CustomInterfaceState('DevKit_Page_1', page == 1);",
            "CustomInterfaceState('DevKit_Page_2', page == 2);",
            "CustomInterfaceState('DevKit_Page_3', page == 3);",
            "CustomInterfaceState('DevKit_Page_4', page == 4);",
            "CustomInterfaceState('DevKit_Page_5', page == 5);",
            "CustomInterfaceState('DevKit_Page_6', page == 6);",
            "CustomInterfaceState('DevKit_Page_7', page == 7);",
            "CustomInterfaceState('DevKit_Page_8', page == 8);",
            "CustomInterfaceState('DevKit_Page_9', page == 9);",
            "CustomInterfaceState('DevKit_Page_10', page == 10);",
            "CustomInterfaceState('DevKit_Page_11', page == 11);",
            "CustomInterfaceState('DevKit_Page_12', page == 12);",
            "CustomInterfaceState('DevKit_Page_13', page == 13);",
            "CustomInterfaceState('DevKit_Page_14', page == 14);",
