        {
          "Type": "Top",
          "Name": "Answer 76",
          "Pos.x": 0,
          "Pos.y": 2800,
          "Parent": 223,
          "#": 224,
          "Total.Lines": 47,
          "Code.Type": "Turn",
          "Code": [
            "    int new_rank = NumberBox('Bm.FormShip2.2SR3_img', 'Укажите желаемое звание', 1, 8, 8, '', min(PlayerScienceRank['CurrentRank'] + 1, 8));\r",
            "    \r",
            "    if(new_rank && new_rank != PlayerScienceRank['CurrentRank'])\r",
            "    {\r",
            "        PlayerScienceRank['CurrentRank'] = new_rank;\r",
            "    \r",
            "        if(new_rank < 8)\r",
            "        {\r",
            "            PlayerScienceRank['HolesToNextRankLeft'] = PlayerScienceRank['HolesToRankRequired', PlayerScienceRank['CurrentRank'] + 1] - PlayerScienceRank['HolesExplored'];\r",
            "    \r",
            "            if(PlayerScienceRank['CurrentRank'] == 5) int rank_image_num = 5;\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 0 || PlayerScienceRank['CurrentRank'] == 7) rank_image_num = 2;\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 3 || PlayerScienceRank['CurrentRank'] == 8) rank_image_num = 4;\r",
            "            else rank_image_num = 3;\r",
            "    \r",
            "            ShipCustomShipInfoData(Player(), 'Science_rank_infos', 1, rank_image_num);\r",
            "            ShipCustomShipInfoData(Player(), 'Science_rank_infos', 2, PlayerScienceRank['HolesToNextRankLeft']);\r",
            "            ShipCustomShipInfoTextData(Player(), 'Science_rank_infos', 1, CT('RankScientific.' + PlayerScienceRank['CurrentRank'] + '.Text'));\r",
            "            ShipCustomShipInfoTextData(Player(), 'Science_rank_infos', 2, CT('RankScientific.' + PlayerScienceRank['CurrentRank'] + '.Name'));\r",
            "    \r",
            "            InterfaceState('Ship', 'CustomRankImage_2_NR', 0);\r",
            "            if(PlayerScienceRank['CurrentRank'] == 1) InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2BH_img');\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 2) InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2SR1_img');\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 3) InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2SR1_img');\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 4) InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2SR2_img');\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 5) InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2SR2_img');\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 6) InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2SR3_img');\r",
            "            else if(PlayerScienceRank['CurrentRank'] == 7) InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2SR3_img');\r",
            "        }\r",
            "        else\r",
            "        {\r",
            "            PlayerScienceRank['HolesToNextRankLeft'] = 0;\r",
            "    \r",
            "            rank_image_num = 4;\r",
            "            ShipCustomShipInfoData(Player(), 'Science_rank_infos', 1, rank_image_num);\r",
            "            ShipCustomShipInfoData(Player(), 'Science_rank_infos', 2, -10);\r",
            "            ShipCustomShipInfoTextData(Player(), 'Science_rank_infos', 1, CT('RankScientific.' + PlayerScienceRank['CurrentRank'] + '.Text'));\r",
            "            ShipCustomShipInfoTextData(Player(), 'Science_rank_infos', 2, CT('RankScientific.' + PlayerScienceRank['CurrentRank'] + '.Name'));\r",
            "            \r",
            "            InterfaceState('Ship', 'CustomRankImage_2_NR', 0);\r",
            "            InterfaceImage('Ship', 'CustomRankImageL_' + rank_image_num, 'GI,Bm.FormShip2.2SR4_img');\r",
            "        }\r",
            "    \r",
            "        Sound('Sound.Repair');\r",
            "    }\r",
            "    DChange(0);\r",
            "    exit;\r"
          ]
        },
