            "}",
            "if(cmd == 69) {",
            "for(i = 0; i <= 3; i = i + 1)",
            "{",
            "int size = CustomArtSizeCalc(int(CT('Artefacts.CustomArtefacts.' + GetValueFromScript('Mod_ExpArts', 'CustomArtsLangNames', i) + '.Size')));",
            "int cost = CustomArtCostCalc(int(CT('Artefacts.CustomArtefacts.' + GetValueFromScript('Mod_ExpArts', 'CustomArtsLangNames', i) + '.Cost')));",
            "tdwd = CreateCustomArt(GetValueFromScript('Mod_ExpArts', 'CustomArtsLangNames', i), size, cost, Rnd(Maloc, Gaal));",
            "AddItemToShip(Player(), tdwd);",
            "}",
            "for(i = 1; i <= 3; i = i + 1)",
            "{",
            "if(i == 1) tdwd = CreateQuestItem('Quark_bomb', PirateClan);",
            "else if(i == 2) tdwd = CreateQuestItem('Stun_bomb', PirateClan);",
            "else tdwd = CreateQuestItem('EMP_bomb', PirateClan);",
            "AddItemToShip(Player(), tdwd);",
            "tdwd = CreateQuestItem('BombDetonator', PirateClan);",
            "AddItemToShip(Player(), tdwd);",
