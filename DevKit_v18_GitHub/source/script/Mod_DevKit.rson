        {
          "Type": "Top",
          "Name": "Dialog: TP_star",
          "Pos.x": 1080,
          "Pos.y": 400,
          "Parent": 37,
          "#": 38,
          "Total.Lines": 24,
          "Code.Type": "Turn",
          "Code": [
            "    //Старый вариант\r",
            "    //if(PlayerBridge()) PlayerBridge(0);\r",
            "    //TransferShip(Player(), GAnswerData);\r",
            "    //PlayerBridge(2);\r",
            "    //PlayerBridge(0);\r",
            "    //ShipChangeStar(Player(), GAnswerData);\r",
            "    \r",
            "    for(temp_int = 0; temp_int < GalaxySectors(); temp_int = temp_int + 1)\r",
            "    {\r",
            "        if(!SectorVisible(GalaxySectors(temp_int))) SectorVisible(GalaxySectors(temp_int), 1);\r",
            "    }\r",
            "    RunChildForm('Galaxy');\r",
            "    if(ShipOrder(Player()) == 7)\r",
            "    {\r",
            "        tdwd = ShipOrderObj(Player());\r",
            "        OrderNone(Player());\r",
            "        if(PlayerBridge()) PlayerBridge(0);\r",
            "        TransferShip(Player(), tdwd);\r",
            "        PlayerBridge(2);\r",
            "        PlayerBridge(0);\r",
            "        ShipChangeStar(Player(), tdwd);\r",
            "    }\r",
            "    DChange(13);\r",
            "    exit;\r"
          ]
        },
        {
          "Type": "Top",
          "Name": "Dialog: KillThisShit",
          "Pos.x": 0,
          "Pos.y": 500,
          "Parent": 39,
          "#": 40,
          "Total.Lines": 2,
          "Code.Type": "Turn",
          "Code": [
            "    ShipDestroy(GetTalkShip(), 1);\r",
            "    FormChange('StarMap');\r"
          ]
        },
        {
          "Type": "Top",
          "Name": "Dialog: GTLChange",
          "Pos.x": 360,
          "Pos.y": 500,
          "Parent": 41,
          "#": 42,
          "Total.Lines": 26,
          "Code.Type": "Turn",
          "Code": [
            "    str new_GTL = NumberBox('Bm.ItemsUseless.2Usl_Elus_s', 'Укажите желаемый ГТУ:', 1, 8, 8, '', GalaxyTechLevel());\r",
            "    \r",
            "    if(int(new_GTL) != GalaxyTechLevel() && new_GTL != 'Cancel')\r",
            "    {\r",
            "        for(i = 0; i < GalaxyStars(); i = i + 1)\r",
            "        {\r",
            "            temp_dword = GalaxyStar(i);\r",
            "            if(StarOwner(temp_dword) == 1) continue;\r",
            "            tstr = StarCustomFaction(temp_dword);\r",
            "            if(tstr != '')\r",
            "            {\r",
            "                if(findsubstr(tstr, 'SubFaction')) continue;\r",
            "            }\r",
            "    \r",
            "            for(j = 0; j < StarPlanets(temp_dword); j = j + 1)\r",
            "            {\r",
            "                tdwd = StarPlanets(temp_dword, j);\r",
            "                if(PlanetOwner(tdwd) == None) continue;\r",
            "                PlanetInventionLevel(tdwd, 7, new_GTL);\r",
            "            }\r",
            "        }\r",
            "    \r",
            "        MessageBox('Для применения изменений пропустите ход.');\r",
            "    }\r",
            "    DChange(0);\r",
            "    exit;\r"
          ]
        },
