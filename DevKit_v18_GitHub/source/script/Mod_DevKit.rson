            "AddItemToShip(Player(),CreateEquipmentWithSpecial(FindBonusByCustomTag('Fakrin_'+3+'_'+i)));",
            "AddItemToShip(Player(),CreateEquipmentWithSpecial(FindBonusByCustomTag('Fakrin_'+4+'_'+i)));",
